<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1250.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.AfficherCreditsController">

    <left>
        <VBox prefWidth="260.0" spacing="10.0" style="-fx-background-color: #2C3E50;">
            <children>
                <VBox alignment="CENTER" prefHeight="120.0" spacing="10.0">
                    <children>
                        <Label text="CHAMPIONS" textFill="WHITE">
                            <font><Font name="System Bold" size="24.0" /></font>
                        </Label>
                        <Label text="FINTECH SOLUTIONS" textFill="#95a5a6" />
                        <Separator maxWidth="180.0" opacity="0.2">
                            <VBox.margin><Insets top="10.0" /></VBox.margin>
                        </Separator>
                    </children>
                </VBox>

                <Button maxWidth="Infinity" prefHeight="55.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="   📊  Tableau de bord">
                    <padding><Insets left="25.0" /></padding>
                </Button>

                <Button maxWidth="Infinity" prefHeight="55.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="   💰  Gestion des Crédits">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>

                <Region VBox.vgrow="ALWAYS" />

                <Button maxWidth="Infinity" prefHeight="50.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Déconnexion">
                    <VBox.margin><Insets bottom="20.0" left="20.0" right="20.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="25.0">
            <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /></padding>
            <children>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Liste des Crédits" textFill="#2d3436">
                                    <font><Font name="System Bold" size="32.0" /></font>
                                </Label>
                                <Label text="Visualisation des demandes de crédit de la base de données" textFill="#636e72" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#ouvrirAjout" prefHeight="45.0" style="-fx-background-color: #0984e3; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;" text="+ NOUVELLE DEMANDE">
                            <padding><Insets left="20.0" right="20.0" /></padding>
                        </Button>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                    <padding><Insets left="20.0" right="20.0" /></padding>
                    <children>
                        <Label text="🔍 " textFill="#b2bec3">
                            <font><Font size="18.0" /></font>
                        </Label>
                        <TextField fx:id="searchField" prefHeight="40.0" prefWidth="550.0" promptText="Rechercher par ID, montant ou description..." style="-fx-background-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 20, 0, 0, 8);" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <children>
                        <TableView fx:id="tableCredits" prefHeight="512.0" style="-fx-background-color: transparent; -fx-selection-bar: #e3f2fd;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" maxWidth="80.0" minWidth="60.0" prefWidth="70.0" text="REF" />
                                <TableColumn fx:id="colMontant" prefWidth="150.0" text="MONTANT" />
                                <TableColumn fx:id="colDevise" maxWidth="100.0" minWidth="80.0" prefWidth="90.0" text="DEVISE" />
                                <TableColumn fx:id="colTaux" prefWidth="100.0" text="TAUX (%)" />
                                <TableColumn fx:id="colStatus" prefWidth="150.0" text="STATUT" />
                                <TableColumn fx:id="colDescription" prefWidth="250.0" text="DESCRIPTION" />
                                <TableColumn fx:id="colActions" maxWidth="150.0" minWidth="120.0" prefWidth="130.0" text="ACTIONS" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>