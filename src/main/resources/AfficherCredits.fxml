<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="25.0" style="-fx-background-color: #f8f9fa;" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.AfficherCreditsController">
    <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /></padding>
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Gestion des Crédits" textFill="#2d3436">
                            <font><Font name="System Bold" size="32.0" /></font>
                        </Label>
                        <Label text="Visualisation et gestion des demandes de financement" textFill="#636e72" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#ouvrirAjout" prefHeight="45.0" style="-fx-background-color: #0984e3; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;" text="+ NOUVELLE DEMANDE" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 3);" HBox.hgrow="ALWAYS">
                    <padding><Insets left="15.0" right="15.0" /></padding>
                    <children>
                        <Label text="🔍 " textFill="#b2bec3" />
                        <TextField fx:id="searchField" promptText="Rechercher un crédit..." style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <Button fx:id="btnEdit" disable="true" onAction="#handleEditSelection" prefHeight="50.0" prefWidth="120.0" style="-fx-background-color: #f1c40f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="✎ Modifier" />
                <Button fx:id="btnDelete" disable="true" onAction="#handleDeleteSelection" prefHeight="50.0" prefWidth="120.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="✕ Supprimer" />
            </children>
        </HBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 20, 0, 0, 8);" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <children>
                <TableView fx:id="tableCredits" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProjet" prefWidth="150.0" text="PROJET" />
                        <TableColumn fx:id="colMontant" prefWidth="100.0" text="MONTANT" />
                        <TableColumn fx:id="colDevise" prefWidth="70.0" text="DEVISE" />
                        <TableColumn fx:id="colTaux" prefWidth="70.0" text="TAUX (%)" />
                        <TableColumn fx:id="colDuree" prefWidth="80.0" text="DURÉE" />

                        <TableColumn fx:id="colStatus" prefWidth="110.0" text="STATUT" />

                        <TableColumn fx:id="colDescription" prefWidth="180.0" text="DESCRIPTION" />

                        <TableColumn fx:id="colActions" prefWidth="120.0" text="ACTIONS" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>