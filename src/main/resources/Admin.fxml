<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="root" prefHeight="800.0" prefWidth="1280.0" stylesheets="@Styles/admin-dashboard.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.AdminPanelService">
    <left>
        <VBox fx:id="sidebar" prefWidth="260.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="12.0">
                    <padding><Insets left="24.0" /></padding>
                    <children>
                        <StackPane prefHeight="36.0" prefWidth="36.0" styleClass="logo-container">
                            <Label styleClass="logo-text" text="C" />
                        </StackPane>
                        <Label styleClass="brand-label" text="CHAMPIONS" />
                    </children>
                </HBox>

                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <padding><Insets left="15.0" right="15.0" top="20.0" /></padding>
                    <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 11;" text="USER MANAGEMENT">
                            <padding><Insets left="10.0" bottom="5.0"/></padding>
                        </Label>
                        <Button fx:id="btnGestionUsers" mnemonicParsing="false" prefHeight="45.0" prefWidth="Infinity" styleClass="nav-button" text="Pending Requests" />
                        <Button fx:id="btnListeUsers" mnemonicParsing="false" prefHeight="45.0" prefWidth="Infinity" styleClass="nav-button" text="All Users" />
                    </children>
                </VBox>

                <VBox spacing="10.0">
                    <padding><Insets bottom="24.0" left="15.0" right="15.0" /></padding>
                    <children>
                        <Button fx:id="btnLogout" mnemonicParsing="false" prefHeight="45.0" prefWidth="Infinity" styleClass="logout-button" text="Logout" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="24.0" styleClass="main-content" BorderPane.alignment="CENTER">
            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="60.0">
                    <children>
                        <VBox>
                            <Label fx:id="lblTitle" styleClass="title-label" text="Overview" />
                            <Label style="-fx-text-fill: #94a3b8;" text="Welcome back, Administrator" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="12.0">
                            <children>
                                <Label styleClass="user-label" text="Admin" />
                                <Circle fill="#3b82f6" radius="18.0" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <VBox fx:id="mainContent" spacing="20.0" VBox.vgrow="ALWAYS" styleClass="table-container">
                    <children>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>