<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="root" prefHeight="800.0" prefWidth="1280.0" styleClass="main-container" stylesheets="@Styles/Styless.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.AdminPanelService">
    <left>
        <VBox fx:id="sidebar" prefWidth="280.0" spacing="10.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="15.0">
                    <padding><Insets left="30.0" /></padding>
                    <children>
                        <StackPane prefHeight="40.0" prefWidth="40.0" styleClass="logo-box">
                            <Label style="-fx-font-weight: 900; -fx-text-fill: white;" text="C" />
                        </StackPane>
                        <Label styleClass="brand-title" style="-fx-font-size: 20;" text="CHAMPIONS" />
                    </children>
                </HBox>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <padding><Insets left="20.0" right="20.0" top="10.0" /></padding>
                    <children>
                        <Label styleClass="input-label" style="-fx-opacity: 0.5; -fx-font-size: 11;" text="MAIN MENU" />
                        <Button fx:id="btnOverview" prefHeight="50.0" prefWidth="Infinity" styleClass="nav-button" text="Dashboard Overview" />
                        <Region prefHeight="20" />
                        <Label styleClass="input-label" style="-fx-opacity: 0.5; -fx-font-size: 11;" text="USER MANAGEMENT" />
                        <Button fx:id="btnGestionUsers" prefHeight="50.0" prefWidth="Infinity" styleClass="nav-button" text="Pending Approvals" />
                        <Button fx:id="btnListeUsers" prefHeight="50.0" prefWidth="Infinity" styleClass="nav-button" text="User Directory" />
                        <Button fx:id="btnLogs" prefHeight="50.0" prefWidth="Infinity" styleClass="nav-button" text="System Logs" />
                        <Button fx:id="btnAssetManagement" prefHeight="50.0" prefWidth="Infinity" styleClass="nav-button" text="Asset management" />
                        <Region prefHeight="20" />
                        <Label styleClass="input-label" style="-fx-opacity: 0.5; -fx-font-size: 11;" text="CONTENT" />
                        <Button fx:id="btnCourses" prefHeight="50.0" prefWidth="Infinity" styleClass="nav-button" text="Fintech Courses" />
                    </children>
                </VBox>

                <VBox spacing="10.0" style="-fx-padding: 20;">
                    <children>
                        <Button fx:id="btnLogout" prefHeight="50.0" prefWidth="Infinity" styleClass="button-secondary" style="-fx-text-fill: #ff4d4d; -fx-border-color: rgba(255,77,77,0.2); -fx-border-radius: 12;" text="Secure Logout" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="30.0" styleClass="form-section" BorderPane.alignment="CENTER">
            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="5">
                            <Label styleClass="brand-title" style="-fx-font-size: 28;" text="System Overview" />
                            <Label styleClass="brand-subtext" text="Real-time platform analytics and governance" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="15.0" styleClass="stat-card" style="-fx-padding: 8 20; -fx-background-radius: 40;">
                            <children>
                                <VBox alignment="CENTER_RIGHT">
                                    <Label fx:id="lblTitle" styleClass="brand-title" style="-fx-font-size: 14;" text="Administrator" />
                                    <Label styleClass="brand-subtext" style="-fx-font-size: 10;" text="Online" />
                                </VBox>
                                <Circle fill="#2E5BFF" radius="20.0" stroke="#ffffff33" strokeType="INSIDE" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <FlowPane hgap="20.0" vgap="20.0" prefWrapLength="1000">
                    <children>
                        <VBox prefWidth="220" spacing="10" styleClass="stat-card">
                            <Label styleClass="brand-subtext" text="Total Users" />
                            <Label styleClass="brand-title" fx:id="lblTotalUsers" style="-fx-font-size: 32;" text="0" />
                            <HBox style="-fx-background-color: rgba(46,91,255,0.1); -fx-padding: 4; -fx-background-radius: 4;">
                                <Label style="-fx-text-fill: #2E5BFF; -fx-font-size: 10;" text="+12% from last month" />
                            </HBox>
                        </VBox>
                        <VBox prefWidth="220" spacing="10" styleClass="stat-card">
                            <Label styleClass="brand-subtext" text="Pending Approval" />
                            <Label styleClass="brand-title" fx:id="lblPendingUsers" style="-fx-font-size: 32; -fx-text-fill: #FFCC00;" text="0" />
                            <Button styleClass="button-secondary" fx:id="rv_now" style="-fx-font-size: 10;" text="Review Now →" />
                        </VBox>
                        <VBox prefWidth="220" spacing="10" styleClass="stat-card">
                            <Label styleClass="brand-subtext" text="Banned/Rejected" />
                            <Label styleClass="brand-title" fx:id="lblDisabledUsers" style="-fx-font-size: 32; -fx-text-fill: #FF4D4D;" text="0" />
                        </VBox>
                        <VBox prefWidth="220" spacing="10" styleClass="stat-card">
                            <Label styleClass="brand-subtext" text="Active Platform Users" />
                            <Label styleClass="brand-title" fx:id="lblActiveUsers" style="-fx-font-size: 32; -fx-text-fill: #10b981;" text="0" />
                            <HBox style="-fx-background-color: rgba(16,185,129,0.1); -fx-padding: 4; -fx-background-radius: 4;">
                                <Label style="-fx-text-fill: #10b981; -fx-font-size: 10;" text="Verified and Live" />
                            </HBox>
                        </VBox>
                    </children>
                </FlowPane>

                <VBox fx:id="mainContent" spacing="25.0" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <children>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox spacing="25.0" style="-fx-padding: 10;">
                                    <children>
                                        <HBox spacing="20.0">
                                            <children>
                                                <VBox spacing="15" styleClass="stat-card" HBox.hgrow="ALWAYS" prefHeight="350">
                                                    <children>
                                                        <Label styleClass="input-label" text="User Acquisition (Growth)" />
                                                        <StackPane fx:id="chartContainer" VBox.vgrow="ALWAYS" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="15" styleClass="stat-card" prefWidth="350" prefHeight="350">
                                                    <children>
                                                        <Label styleClass="input-label" text="Verification Split" />
                                                        <StackPane fx:id="pieChartContainer" VBox.vgrow="ALWAYS" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <VBox spacing="15" styleClass="stat-card" VBox.vgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label styleClass="input-label" text="Recent System Pulse" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Button styleClass="button-secondary" style="-fx-font-size: 11;" text="Logs" />
                                                    </children>
                                                </HBox>
                                                <Separator opacity="0.1" />
                                                <VBox fx:id="recentActivityList" spacing="12">
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>