<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="550.0" spacing="0.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.AjouterProjetController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: #27ae60;">
            <children>
                <Label text="CRÉER UN NOUVEAU PROJET" textFill="WHITE">
                    <font><Font name="System Bold" size="18.0" /></font>
                </Label>
            </children>
            <padding><Insets left="30.0" /></padding>
        </HBox>

        <VBox spacing="20.0">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
            <children>
                <GridPane hgap="20.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <VBox spacing="5.0" GridPane.columnSpan="2">
                            <children>
                                <Label text="Titre du Projet" textFill="#636e72" />
                                <TextField fx:id="txtTitre" prefHeight="40.0" promptText="Nom du projet de financement..." style="-fx-background-radius: 5;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.rowIndex="1">
                            <children>
                                <Label text="Objectif de Financement" textFill="#636e72" />
                                <TextField fx:id="txtMontant" prefHeight="40.0" promptText="0.00" style="-fx-background-radius: 5;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <children>
                                <Label text="Statut" textFill="#636e72" />
                                <ComboBox fx:id="comboStatus" maxWidth="Infinity" prefHeight="40.0" style="-fx-background-radius: 5;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.rowIndex="2">
                            <children>
                                <Label text="Date de Début" textFill="#636e72" />
                                <DatePicker fx:id="dateDebut" maxWidth="Infinity" prefHeight="40.0" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <children>
                                <Label text="Date de Fin" textFill="#636e72" />
                                <DatePicker fx:id="dateFin" maxWidth="Infinity" prefHeight="40.0" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="3">
                            <children>
                                <Label text="Description détaillée" textFill="#636e72" />
                                <TextArea fx:id="txtDescription" prefHeight="80.0" promptText="Décrivez les objectifs du projet..." style="-fx-background-radius: 5;" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button onAction="#annuler" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: transparent; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-cursor: hand;" text="Annuler" textFill="#7f8c8d" />
                        <Button onAction="#enregistrer" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-cursor: hand;" text="CRÉER LE PROJET" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>