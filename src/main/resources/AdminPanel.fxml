<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.AdminPanelService">

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="200" spacing="15" style="-fx-background-color: #2C3E50; -fx-padding: 15;">

            <Label style="-fx-text-fill: white; -fx-font-size: 18px;" text="Admin Panel" />

            <Button fx:id="btnGestionUsers" maxWidth="Infinity" text="Gestion Users" />
         <Button fx:id="btnListeUsers" maxWidth="Infinity" text="liste des utilisateurs" />
        </VBox>
    </left>

    <!-- Dynamic Content Area -->
    <center>
        <VBox fx:id="mainContent" prefHeight="400.0" prefWidth="632.0" spacing="10" style="-fx-padding: 20;">

            <Label style="-fx-font-size: 22px;" text="Welcome Admin 👋" />

        </VBox>
    </center>

</BorderPane>
