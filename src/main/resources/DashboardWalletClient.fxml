                                                </ImageView>
                                            </HBox>
                                            <VBox fx:id="cardForm" managed="false" spacing="10"
                                                  style="-fx-background-color: #111827; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #00D4FF; -fx-border-width: 1; -fx-border-radius: 10;"
                                                  visible="false">
                                                <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #F0F4FF;" text="💳  Card Information" />
                                                <Label fx:id="cardErrorLabel" managed="false"
                                                       style="-fx-font-size: 12; -fx-text-fill: #ef4444;"
                                                       visible="false" wrapText="true" />
                                                <GridPane hgap="10" vgap="8">
                                                    <columnConstraints>
                                                        <ColumnConstraints prefWidth="100" />
                                                        <ColumnConstraints prefWidth="185" />
                                                    </columnConstraints>
                                                    <Label text="Titulaire" style="-fx-font-size: 12; -fx-text-fill: #8B9AB5;" />
                                                    <TextField fx:id="cardHolderField"
                                                               style="-fx-background-color: #1A2235; -fx-text-fill: white; -fx-border-color: #1E2D45; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"
                                                               GridPane.columnIndex="1" />
                                                    <Label text="N° Carte" style="-fx-font-size: 12; -fx-text-fill: #8B9AB5;" GridPane.rowIndex="1" />
                                                    <TextField fx:id="cardNumberField"
                                                               style="-fx-background-color: #1A2235; -fx-text-fill: white; -fx-border-color: #1E2D45; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"
                                                               GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                    <Label text="Mois" style="-fx-font-size: 12; -fx-text-fill: #8B9AB5;" GridPane.rowIndex="2" />
                                                    <TextField fx:id="expMonthField"
                                                               style="-fx-background-color: #1A2235; -fx-text-fill: white; -fx-border-color: #1E2D45; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"
                                                               GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                    <Label text="Année" style="-fx-font-size: 12; -fx-text-fill: #8B9AB5;" GridPane.rowIndex="3" />
                                                    <TextField fx:id="expYearField"
                                                               style="-fx-background-color: #1A2235; -fx-text-fill: white; -fx-border-color: #1E2D45; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"
                                                               GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                    <rowConstraints>
                                                        <RowConstraints />
                                                        <RowConstraints />
                                                        <RowConstraints />
                                                        <RowConstraints />
                                                    </rowConstraints>
                                                </GridPane>
                                                <HBox alignment="CENTER" spacing="10">
                                                    <Button onAction="#handleSave"
                                                            style="-fx-background-color: linear-gradient(to right, #00D4FF, #00A3FF); -fx-text-fill: #0A0E1A; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 18; -fx-cursor: hand;"
                                                            text="💾  Save" />
                                                    <Button onAction="#handleCloseCardForm"
                                                            style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-border-color: rgba(239,68,68,0.4); -fx-border-radius: 8; -fx-border-width: 1; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 18;"
                                                            text="✕  Close" />
                                                </HBox>
                                            </VBox>
                                            <!-- Chip -->
                                            <StackPane alignment="CENTER_LEFT" prefHeight="28.0" prefWidth="40.0">
                                                <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#fcd34d" height="26.0" width="40.0" />
                                                <GridPane gridLinesVisible="true" maxHeight="26.0" maxWidth="40.0"
                                                          style="-fx-border-color: #b48a04; -fx-border-width: 0.2;">
                                                    <columnConstraints>
                                                        <ColumnConstraints prefWidth="13.3" />
                                                        <ColumnConstraints prefWidth="13.3" />
                                                        <ColumnConstraints prefWidth="13.3" />
                                                    </columnConstraints>
                                                    <rowConstraints>
                                                        <RowConstraints prefHeight="13.0" />
                                                        <RowConstraints prefHeight="13.0" />
                                                    </rowConstraints>
                                                </GridPane>
                                            </StackPane>
                                            <!-- Card number -->
                                            <Label fx:id="rib" text="**** **** **** 4589" textFill="WHITE">
                                                <font><Font name="Monospaced Bold" size="17.0" /></font>
                                                <VBox.margin><Insets top="12.0" /></VBox.margin>
                                            </Label>
                                            <!-- Cardholder + Mastercard logo -->
                                            <HBox alignment="BOTTOM_LEFT" VBox.vgrow="ALWAYS">
                                                <Label fx:id="nom" text="JOHN DOE" textFill="WHITE" opacity="0.9">
                                                    <font><Font name="System Bold" size="12.0" /></font>
                                                </Label>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <HBox spacing="-10.0">
                                                    <Circle fill="#eb001b" radius="12.0" />
                                                    <Circle fill="#f79e1b" opacity="0.85" radius="12.0" />
                                                </HBox>
                                            </HBox>
                                        </VBox>
                                    </StackPane>

                                    <!-- Card action buttons -->
                                    <HBox alignment="CENTER" spacing="12.0" style="-fx-padding: 4 0 0 0;">
                                        <Button fx:id="btnInfosCarte" onAction="#handleInfosCarte"
                                                prefHeight="38.0" prefWidth="140.0"
                                                style="-fx-background-color: transparent; -fx-border-color: #00D4FF; -fx-border-radius: 8; -fx-border-width: 1; -fx-text-fill: #00D4FF; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;"
                                                text="💳  Card Info" />
                                        <Button fx:id="btnDeleteCarte" onAction="#handleDeleteCarte"
                                                prefHeight="38.0" prefWidth="140.0"
                                                style="-fx-background-color: transparent; -fx-border-color: rgba(239,68,68,0.5); -fx-border-radius: 8; -fx-border-width: 1; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;"
                                                text="🗑  Delete" />
                                    </HBox>
                                </VBox>
                            </StackPane>
                        </content>
                    </ScrollPane>

                    <!-- RIGHT PANEL -->
                    <ScrollPane fitToWidth="true"
                                style="-fx-background-color: transparent; -fx-background: transparent;"
                                HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox spacing="16" style="-fx-padding: 0 5 0 0;">

                                <!-- Pie Chart -->
                                <VBox alignment="CENTER" prefHeight="290.0"
                                      style="-fx-background-color: #111827; -fx-background-radius: 16; -fx-padding: 18; -fx-border-color: #1E2D45; -fx-border-radius: 16; -fx-border-width: 1;">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #F0F4FF;" text="Global Balance by Asset" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label style="-fx-font-size: 11; -fx-text-fill: #8B9AB5;" text="Portfolio overview" />
                                    </HBox>
                                    <PieChart fx:id="currencyChart" legendSide="RIGHT" prefHeight="240.0"
                                              style="-fx-background-color: transparent;" />
                                </VBox>

                                <!-- Search bar -->
                                <HBox alignment="CENTER_LEFT" spacing="12"
                                      style="-fx-padding: 14 18; -fx-background-color: #111827; -fx-background-radius: 12; -fx-border-color: #1E2D45; -fx-border-radius: 12; -fx-border-width: 1;">
                                    <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #F0F4FF;" text="Wallet List" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="txtSearch" onKeyReleased="#handleSearch"
                                               promptText="🔍  Search wallets..."
                                               style="-fx-background-color: #1A2235; -fx-text-fill: white; -fx-prompt-text-fill: #4A5568; -fx-border-color: #1E2D45; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 14;" />
                                    <Button fx:id="btnClearSearch" onAction="#handleClearSearch"
                                            style="-fx-background-color: #1E2D45; -fx-text-fill: #8B9AB5; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 9 16;"
                                            text="Clear" />
                                </HBox>

                                <!-- FIAT -->
                                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4 0 0 0;">
                                    <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #00D4FF;" text="FIAT WALLETS" />
                                    <Separator style="-fx-opacity: 0.15;" HBox.hgrow="ALWAYS" />
                                </HBox>
                                <ScrollPane fx:id="scrollWallets" fitToHeight="true" hbarPolicy="AS_NEEDED"
                                            minHeight="210.0" prefHeight="220.0"
                                            style="-fx-background-color: transparent; -fx-background: transparent;"
                                            vbarPolicy="NEVER">
                                    <content>
                                        <HBox fx:id="walletContainer" alignment="CENTER_LEFT" spacing="15"
                                              style="-fx-padding: 5 10;" />
                                    </content>
                                </ScrollPane>

                                <!-- CRYPTO -->
                                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4 0 0 0;">
                                    <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #7C3AED;" text="CRYPTO WALLETS" />
                                    <Separator style="-fx-opacity: 0.15;" HBox.hgrow="ALWAYS" />
                                </HBox>
                                <ScrollPane fx:id="scrollWallets1" fitToHeight="true" hbarPolicy="AS_NEEDED"
                                            minHeight="210.0" prefHeight="220.0"
                                            style="-fx-background-color: transparent; -fx-background: transparent;"
                                            vbarPolicy="NEVER">
                                    <content>
                                        <HBox fx:id="walletContainer1" alignment="CENTER_LEFT" spacing="15"
                                              style="-fx-padding: 5 10;" />
                                    </content>
                                </ScrollPane>

                                <!-- TRADING -->
                                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4 0 0 0;">
                                    <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #00FFA3;" text="TRADING WALLETS" />
                                    <Separator style="-fx-opacity: 0.15;" HBox.hgrow="ALWAYS" />
                                </HBox>
                                <ScrollPane fx:id="scrollWallets2" fitToHeight="true" hbarPolicy="AS_NEEDED"
                                            minHeight="210.0" prefHeight="220.0"
                                            style="-fx-background-color: transparent; -fx-background: transparent;"
                                            vbarPolicy="NEVER">
                                    <content>
                                        <HBox fx:id="walletContainer2" alignment="CENTER_LEFT" spacing="15"
                                              style="-fx-padding: 5 10;" />
                                    </content>
                                </ScrollPane>

                            </VBox>
                        </content>
                    </ScrollPane>

                </HBox>
            </VBox>
        </center>
    </BorderPane>
</StackPane>