<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="750.0" prefWidth="1100.0" spacing="30" style="-fx-background-color: #0A0E1A;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.fournisseur.FournisseurDashboardController">
    <padding>
        <Insets bottom="25" left="25" right="25" top="25" />
    </padding>

    <children>
        <VBox prefWidth="380.0" spacing="20" style="-fx-background-color: #111827; -fx-background-radius: 20; -fx-border-color: #1E2D45; -fx-border-radius: 20; -fx-padding: 25;">
            <children>
                <VBox spacing="5">
                    <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #F0F4FF;" text="Gestion Inventaire" />
                    <Label style="-fx-text-fill: #8B9AB5; -fx-font-size: 13;" text="Ajouter ou modifier un actif" />
                </VBox>

                <Separator opacity="0.1" />

                <VBox spacing="12">
                    <VBox spacing="5">
                        <Label style="-fx-text-fill: #8B9AB5; -fx-font-weight: bold;" text="Nom du produit" />
                        <TextField fx:id="nameField" promptText="ex: Ledger Nano X" style="-fx-background-color: #1A2235; -fx-text-fill: white; -fx-border-color: #1E2D45; -fx-border-radius: 8;" />
                        <Label fx:id="nameError" managed="false" style="-fx-text-fill: #FF4757; -fx-font-size: 11;" visible="false" />
                    </VBox>

                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #8B9AB5; -fx-font-weight: bold;" text="Marque" />
                            <TextField fx:id="brandField" style="-fx-background-color: #1A2235; -fx-text-fill: white; -fx-border-color: #1E2D45; -fx-border-radius: 8;" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #8B9AB5; -fx-font-weight: bold;" text="Catégorie" />
                            <ComboBox fx:id="categoryCombo" maxWidth="Infinity" style="-fx-background-color: #1A2235; -fx-border-color: #1E2D45; -fx-border-radius: 8;" />
                        </VBox>
                    </HBox>

                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: #8B9AB5; -fx-font-weight: bold;" text="Description" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleAutoCorrect" style="-fx-background-color: rgba(0, 212, 255, 0.1); -fx-text-fill: #00D4FF; -fx-font-size: 10; -fx-background-radius: 5; -fx-cursor: hand;" text="✨ Correction IA" />
                        </HBox>
                        <TextArea fx:id="descField" prefHeight="80" promptText="Détails techniques..." style="-fx-control-inner-background: #1A2235; -fx-text-fill: white; -fx-border-color: #1E2D45;" wrapText="true" />
                    </VBox>

                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #00FFA3; -fx-font-weight: bold;" text="Prix (BTC)" />
                            <TextField fx:id="priceField" promptText="0.00" style="-fx-background-color: #1A2235; -fx-text-fill: white; -fx-border-color: #1E2D45;" />
                            <Label fx:id="priceError" managed="false" style="-fx-text-fill: #FF4757; -fx-font-size: 11;" visible="false" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #FF8C00; -fx-font-weight: bold;" text="Promo (BTC)" />
                            <TextField fx:id="discountPriceField" promptText="0.00" style="-fx-background-color: #1A2235; -fx-text-fill: white; -fx-border-color: #1E2D45;" />
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label style="-fx-text-fill: #8B9AB5; -fx-font-weight: bold;" text="Stock disponible" />
                        <Spinner fx:id="stockSpinner" editable="true" maxWidth="Infinity" style="-fx-background-color: #1A2235;" />
                    </VBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox spacing="12">
                    <Button maxWidth="Infinity" onAction="#handleUploadImage" style="-fx-background-color: #1A2235; -fx-text-fill: #8B9AB5; -fx-border-color: #1E2D45; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10; -fx-cursor: hand;" text="📁 Uploader l'image" />
                    <Label fx:id="imageStatus" alignment="CENTER" maxWidth="Infinity" style="-fx-text-fill: #4A5568; -fx-font-size: 11;" text="Aucun fichier sélectionné" />

                    <Button fx:id="saveButton" maxWidth="Infinity" onAction="#handleSave" prefHeight="50" style="-fx-background-color: linear-gradient(to right, #7C3AED, #5B21B6); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 12; -fx-cursor: hand;" text="ENREGISTRER LE PRODUIT" />
                </VBox>
            </children>
        </VBox>

        <VBox spacing="20" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <children>
                        <VBox>
                            <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;" text="Mes Produits en vente" />
                            <Label style="-fx-text-fill: #8B9AB5;" text="Aperçu de vos performances" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="adminSearchField" prefWidth="220" promptText="Rechercher..." style="-fx-background-color: #111827; -fx-text-fill: white; -fx-border-color: #1E2D45; -fx-background-radius: 10; -fx-border-radius: 10;" />
                        <Button onAction="#handleShowStats" style="-fx-background-color: #00D4FF; -fx-text-fill: #0A0E1A; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="📊 Stats" />
                        <Button onAction="#handleExportCSV" style="-fx-background-color: transparent; -fx-text-fill: #8B9AB5; -fx-border-color: #8B9AB5; -fx-border-radius: 8; -fx-cursor: hand;" text="Exporter CSV" />
                    </children>
                </HBox>

                <TableView fx:id="productsTable" style="-fx-background-color: #111827; -fx-background-radius: 15; -fx-border-color: #1E2D45; -fx-border-radius: 15; -fx-padding: 5;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName" prefWidth="180" text="Produit" />
                        <TableColumn fx:id="colPrice" prefWidth="100" text="Prix" />
                        <TableColumn fx:id="colDiscount" prefWidth="100" text="Promo" />
                        <TableColumn fx:id="colStock" prefWidth="80" text="Stock" />
                        <TableColumn fx:id="colStatus" prefWidth="100" text="Statut" />
                        <TableColumn fx:id="colAction" prefWidth="150" text="Actions" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</HBox>