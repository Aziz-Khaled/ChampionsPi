<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.client.CartController" spacing="20">
    <children>
        <Label text="Votre Panier" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

        <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colProduct" text="Produit" prefWidth="250"/>
                <TableColumn fx:id="colQuantity" text="Quantité" prefWidth="100"/>
                <TableColumn fx:id="colPrice" text="Prix Unitaire" prefWidth="150"/>
                <TableColumn fx:id="colTotal" text="Total" prefWidth="150"/>
                <TableColumn fx:id="colAction" text="Action" prefWidth="100"/>
            </columns>
        </TableView>

        <!-- AI Recommendations Section -->
        <VBox spacing="10" styleClass="card" style="-fx-background-color: #f0fdf4; -fx-border-color: -fx-primary-emerald; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="✨ Recommandé par l'IA pour vous" style="-fx-font-weight: bold; -fx-text-fill: -fx-primary-dark;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="aiRecBtn" text="Actualiser l'IA" onAction="#handleAIRecommendations" styleClass="btn-secondary" style="-fx-font-size: 11;"/>
            </HBox>
            <ScrollPane fx:id="aiRecommendationPane" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <HBox fx:id="aiRecommendationBox" spacing="15" alignment="CENTER_LEFT">
                    <!-- Cards will be injected here by controller -->
                    <Label text="Chargement des recommandations..." style="-fx-text-fill: -fx-text-light;"/>
                </HBox>
            </ScrollPane>
        </VBox>

        <HBox spacing="20" alignment="CENTER_RIGHT">
            <VBox alignment="CENTER_RIGHT" spacing="5">
                <Label text="Total à payer:" style="-fx-font-size: 14; -fx-text-fill: -fx-text-light;"/>
                <Label fx:id="totalLabel" text="0.00 BTC" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: -fx-primary-emerald;"/>
            </VBox>
            <Button text="Passer la commande" styleClass="btn-primary" prefHeight="50" prefWidth="200" onAction="#handleCheckout"/>
        </HBox>
    </children>
</VBox>