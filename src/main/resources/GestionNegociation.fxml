<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.NegociationController">
    <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
    <children>
        <HBox style="-fx-background-color: #2c3e50; -fx-background-radius: 15; -fx-padding: 20;">
            <children>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Mon Crédit Immobilier #125" textFill="WHITE">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Label text="Montant : 50 000 TND | Taux souhaité : 5.0%" textFill="#bdc3c7" />
                    </children>
                </VBox>
                <Label style="-fx-text-fill: #f1c40f; -fx-font-weight: bold;" text="3 OFFRES REÇUES" />
            </children>
        </HBox>

        <Label text="Offres des Investisseurs" textFill="#34495e">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox fx:id="containerOffres" spacing="15.0">
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>