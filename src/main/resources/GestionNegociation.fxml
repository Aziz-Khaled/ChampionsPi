<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #1a1f2b;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.NegociationController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>
    <children>
        <HBox style="-fx-background-color: #232e3e; -fx-background-radius: 15; -fx-padding: 20; -fx-border-color: #34495e; -fx-border-radius: 15;">
            <children>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblTitreCredit" text="Chargement du projet..." textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblDetailsCredit" text="Montant : -- TND | Taux souhaité : --%" textFill="#bdc3c7">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <VBox alignment="CENTER_RIGHT">
                    <children>
                        <Label fx:id="lblNbOffres" style="-fx-text-fill: #f1c40f; -fx-font-weight: bold;" text="0 OFFRE(S) REÇUE(S)">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <Label text="Offres des Investisseurs" textFill="#ecf0f1">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #1a1f2b; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="containerOffres" spacing="15.0" style="-fx-background-color: #1a1f2b;">
                    <padding>
                        <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>