<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="25.0" style="-fx-background-color: #f8f9fa;" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.AfficherProjetsController">
    <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /></padding>
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Gestion des Projets" textFill="#2d3436">
                            <font><Font name="System Bold" size="32.0" /></font>
                        </Label>
                        <Label text="Liste des projets de financement participatif" textFill="#636e72" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#ouvrirAjout" prefHeight="45.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;" text="+ NOUVEAU PROJET" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
            <padding><Insets left="20.0" right="20.0" /></padding>
            <children>
                <Label text="🔍 " textFill="#b2bec3" />
                <TextField fx:id="searchField" prefHeight="40.0" prefWidth="550.0" promptText="Rechercher un projet..." style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 15;" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
            <children>
                <TableView fx:id="tableProjets" prefHeight="512.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colTitre" prefWidth="180.0" text="TITRE" />
                        <TableColumn fx:id="colDescription" prefWidth="200.0" text="DESCRIPTION" />
                        <TableColumn fx:id="colMontant" prefWidth="120.0" text="OBJECTIF" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="STATUT" />
                        <TableColumn fx:id="colDateDebut" prefWidth="150.0" text="DATE DÉBUT" />
                        <TableColumn fx:id="colActions" prefWidth="130.0" text="ACTIONS" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>