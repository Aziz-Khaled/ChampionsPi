<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: #f8f9fa;" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.AfficherProjetsController">
    <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /></padding>
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Gestion des Projets" textFill="#2d3436">
                            <font><Font name="System Bold" size="32.0" /></font>
                        </Label>
                        <Label text="Liste des projets de financement participatif" textFill="#636e72" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#ouvrirAjout" prefHeight="45.0" style="-fx-background-color: #0984e3; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;" text="+ NOUVEAU PROJET" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 3);" HBox.hgrow="ALWAYS">
                    <padding><Insets left="15.0" right="15.0" /></padding>
                    <children>
                        <Label text="🔍 " textFill="#b2bec3" />
                        <TextField fx:id="searchField" promptText="Rechercher un projet..." style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <Button fx:id="btnEdit" disable="true" onAction="#handleEditSelection" prefHeight="50.0" prefWidth="120.0" style="-fx-background-color: #f1c40f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="✎ Modifier" />
                <Button fx:id="btnDelete" disable="true" onAction="#handleDeleteSelection" prefHeight="50.0" prefWidth="120.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="✕ Supprimer" />
            </children>
        </HBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <children>
                <TableView fx:id="tableProjets" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTitre" prefWidth="150.0" text="TITRE" />
                        <TableColumn fx:id="colDescription" prefWidth="200.0" text="DESCRIPTION" />
                        <TableColumn fx:id="colMontant" prefWidth="100.0" text="OBJECTIF" />
                        <TableColumn fx:id="colStatus" prefWidth="100.0" text="STATUT" />
                        <TableColumn fx:id="colDateDebut" prefWidth="130.0" text="DATE DÉBUT" />
                        <TableColumn fx:id="colDateFin" prefWidth="130.0" text="DATE FIN" /> </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>