<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox prefHeight="800.0" prefWidth="1100.0" styleClass="main-container" stylesheets="@/Styles/Styless.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.LoginService">
    <children>
        <VBox alignment="CENTER_LEFT" prefWidth="420.0" spacing="35.0" styleClass="brand-section" HBox.hgrow="NEVER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <StackPane styleClass="logo-box" prefWidth="45" prefHeight="45">
                            <children>
                                <Label style="-fx-font-family: 'System'; -fx-font-style: italic; -fx-font-weight: 900; -fx-font-size: 22;" text="C" textFill="WHITE" />
                            </children>
                        </StackPane>
                        <Label styleClass="brand-title" text="CHAMPIONS." />
                    </children>
                </HBox>

                <VBox spacing="15.0">
                    <children>
                        <Label styleClass="brand-headline" text="The future of crypto is here." wrapText="true" />
                        <Label styleClass="brand-subtext" text="Log in to manage your digital assets with the next generation of fintech tools." wrapText="true" />
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox spacing="5">
                    <children>
                        <Label styleClass="brand-subtext" style="-fx-font-size: 12;" text="Secured by 256-bit Encryption" />
                        <Label styleClass="brand-subtext" style="-fx-font-size: 11; -fx-opacity: 0.5;" text="© 2026 Champions Platform" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <VBox alignment="CENTER" styleClass="form-section" HBox.hgrow="ALWAYS">
            <children>
                <VBox maxWidth="400.0" spacing="35.0" styleClass="form-content-area">
                    <children>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="brand-title" style="-fx-font-size: 36;" text="Login" />
                                <Label styleClass="brand-subtext" text="Enter your credentials to access your vault." />
                            </children>
                        </VBox>

                        <VBox spacing="25.0">
                            <children>
                                <VBox spacing="8.0">
                                    <children>
                                        <Label styleClass="input-label" text="Email Address" />
                                        <TextField fx:id="txt_Email" promptText="name@company.com" />
                                    </children>
                                </VBox>
                                <VBox spacing="8.0">
                                    <children>
                                        <Label styleClass="input-label" text="Password" />
                                        <PasswordField fx:id="txt_Password" promptText="••••••••" />
                                    </children>
                                </VBox>

                                <VBox spacing="15.0" alignment="CENTER">
                                    <children>
                                        <Button fx:id="btn_Login" maxWidth="Infinity" styleClass="button-primary" text="Sign In to Platform" />
                                        <HBox alignment="CENTER" spacing="10">
                                            <children>
                                                <Separator HBox.hgrow="ALWAYS" opacity="0.1" />
                                                <Label styleClass="brand-subtext" style="-fx-font-size: 11;" text="OR CONTINUE WITH" />
                                                <Separator HBox.hgrow="ALWAYS" opacity="0.1" />
                                            </children>
                                        </HBox>

                                        <Button fx:id="btn_GoogleLogin" maxWidth="Infinity" styleClass="button-google" text="Sign in with Google">
                                            <graphic>
                                                <StackPane style="-fx-padding: 0 10 0 0;">
                                                    <Circle radius="8" fill="white" />
                                                </StackPane>
                                            </graphic>
                                        </Button>
                                        <HBox alignment="CENTER" spacing="8">
                                            <children>
                                                <Label styleClass="brand-subtext" text="New to Champions?" />
                                                <Button onAction="#openSignUpPage" styleClass="button-secondary" text="Create Account" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>