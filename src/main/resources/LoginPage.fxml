<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="800.0" prefWidth="1100.0" styleClass="main-container" stylesheets="@/Styles/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.LoginService">
    <children>
        <VBox alignment="CENTER_LEFT" prefWidth="400.0" spacing="30.0" styleClass="brand-section" HBox.hgrow="NEVER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <StackPane styleClass="logo-box">
                            <children>
                                <Label style="-fx-font-style: italic; -fx-font-weight: bold; -fx-font-size: 20;" text="C" textFill="WHITE" />
                            </children>
                        </StackPane>
                        <Label styleClass="brand-title" text="CHAMPIONS." />
                    </children>
                </HBox>
                <VBox spacing="15.0">
                    <children>
                        <Label styleClass="brand-headline" text="Welcome back to the future." wrapText="true" />
                        <Label styleClass="brand-subtext" text="Log in to manage your assets and track your financial journey." wrapText="true" />
                    </children>
                </VBox>
                <Region VBox.vgrow="ALWAYS" />
                <Label styleClass="brand-subtext" text="© 2026 Champions Platform" />
            </children>
        </VBox>

        <VBox alignment="CENTER" styleClass="form-section" HBox.hgrow="ALWAYS">
            <children>
                <VBox maxWidth="400.0" spacing="30.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-size: 32; -fx-font-weight: bold;" text="Login" />
                                <Label style="-fx-text-fill: #64748b;" text="Enter your credentials to access your account" />
                            </children>
                        </VBox>

                        <VBox spacing="20.0">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label styleClass="input-label" text="Email Address" />
                                        <TextField fx:id="txt_Email" promptText="name@company.com" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label styleClass="input-label" text="Password" />
                                        <PasswordField fx:id="txt_Password" promptText="••••••••" />
                                    </children>
                                </VBox>
                                <Button fx:id="btn_Login" maxWidth="Infinity" styleClass="button-primary" text="Sign In" />

                                <HBox alignment="CENTER" spacing="5">
                                    <children>
                                        <Label text="Don't have an account?" textFill="#64748b" />
                                        <Button onAction="#openSignUpPage" styleClass="button-secondary" text="Create Account" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>