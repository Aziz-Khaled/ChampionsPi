<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f1f2f6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.MainDashboardController">
    <children>
        <VBox prefWidth="260.0" style="-fx-background-color: #2c3e50;">
            <children>
                <Label text="CHAMPIONS" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0" /></font>
                    <VBox.margin><Insets bottom="40.0" left="25.0" top="30.0" /></VBox.margin>
                </Label>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnDashboard" prefHeight="50.0" prefWidth="260.0" text="🏠  Tableau de bord" />
                        <Button fx:id="btnProjets" prefHeight="50.0" prefWidth="260.0" text="📁  Gestion Projets" />
                        <Button fx:id="btnCredits" prefHeight="50.0" prefWidth="260.0" text="💰  Demandes Crédits" />
                        <Button fx:id="btnNegociations" prefHeight="50.0" prefWidth="260.0" text="🤝  Négociations" />
                    </children>
                </VBox>

                <Separator opacity="0.1" />
                <Button prefHeight="50.0" prefWidth="260.0" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c;" text="🚪  Déconnexion" />
            </children>
        </VBox>

        <VBox HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <padding><Insets left="30.0" right="30.0" /></padding>
                    <children>
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="lblWelcome" text="Bienvenue, Utilisateur" textFill="#2d3436">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </Label>
                                <Label fx:id="lblRole" text="Rôle : Emprunteur" textFill="#636e72" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField promptText="Recherche globale..." style="-fx-background-radius: 20; -fx-background-color: #f1f2f6; -fx-pref-width: 300; -fx-padding: 8 15;" />
                    </children>
                </HBox>

                <VBox fx:id="mainContent" spacing="30.0" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                    <children>
                        <HBox spacing="25.0">
                            <children>
                                <VBox prefHeight="150.0" prefWidth="280.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                    <children>
                                        <Label text="TOTAL CRÉDITS" textFill="#636e72"><font><Font name="System Bold" size="14.0" /></font></Label>
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label fx:id="statTotalCredits" text="0" textFill="#0984e3"><font><Font name="System Bold" size="36.0" /></font></Label>
                                        <Label text="+2 demandes aujourd'hui" textFill="#27ae60" style="-fx-font-size: 11;" />
                                    </children>
                                </VBox>

                                <VBox prefHeight="150.0" prefWidth="280.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                    <children>
                                        <Label text="PROJETS ACTIFS" textFill="#636e72"><font><Font name="System Bold" size="14.0" /></font></Label>
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label fx:id="statTotalProjets" text="0" textFill="#6c5ce7"><font><Font name="System Bold" size="36.0" /></font></Label>
                                        <Label text="Financement en cours" textFill="#636e72" style="-fx-font-size: 11;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>