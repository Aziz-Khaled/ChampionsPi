<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1250.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.MainDashboardController">
    <left>
        <VBox prefWidth="250.0" spacing="10" style="-fx-background-color: #2C3E50;">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="30.0" />
            </padding>
            <children>
                <Label style="-fx-text-fill: white;" text="CHAMPIONS">
                    <font><Font name="System Bold" size="24.0" /></font>
                    <VBox.margin><Insets bottom="5.0" /></VBox.margin>
                </Label>
                <Label style="-fx-text-fill: #95a5a6;" text="FINTECH SOLUTIONS">
                    <font><Font size="12.0" /></font>
                </Label>

                <Separator opacity="0.2">
                    <VBox.margin><Insets bottom="20.0" top="10.0" /></VBox.margin>
                </Separator>

                <Button fx:id="btnProjets" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="   📁  Gestion Projets">
                    <font><Font size="14.0" /></font>
                </Button>

                <Button fx:id="btnCredits" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="   💰  Liste des Crédits">
                    <font><Font size="14.0" /></font>
                </Button>

                <Button fx:id="btnNegociations" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="   🤝  Négociations">
                    <font><Font size="14.0" /></font>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox fx:id="mainContent" alignment="CENTER" prefHeight="650.0" prefWidth="908.0" spacing="15.0" style="-fx-background-color: #f8f9fa;">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <Label style="-fx-font-weight: bold;" text="Bienvenue dans le module Fintech 👋" textFill="#2c3e50">
                    <font><Font size="32.0" /></font>
                </Label>
                <Label text="Veuillez choisir une option dans le menu de gauche pour commencer" textFill="#7f8c8d">
                    <font><Font size="16.0" /></font>
                </Label>
            </children>
        </VBox>
    </center>
</BorderPane>