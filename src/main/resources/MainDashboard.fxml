<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="750.0" prefWidth="1250.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.MainDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding><Insets left="20.0" right="20.0" /></padding>
            <children>
                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblWelcome" text="Bienvenue, Sarra Gharbi 👋" textFill="#2c3e50">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Label fx:id="lblRole" text="Rôle : Administrateur" textFill="#7f8c8d" />
                    </children>
                </VBox>
                <HBox alignment="CENTER" spacing="15">
                    <children>
                        <Separator orientation="VERTICAL" prefHeight="30.0" />
                        <Button style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Déconnexion" />
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="250.0" spacing="10" style="-fx-background-color: #2C3E50;">
            <padding><Insets bottom="20.0" left="15.0" right="15.0" top="30.0" /></padding>
            <children>
                <Label style="-fx-text-fill: white;" text="CHAMPIONS">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
                <Label style="-fx-text-fill: #95a5a6;" text="FINTECH SOLUTIONS" />
                <Separator opacity="0.2"><VBox.margin><Insets bottom="20.0" top="10.0" /></VBox.margin></Separator>

                <Button fx:id="btnDashboard" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-background-radius: 5;" text="   🏠  Dashboard">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>

                <Button fx:id="btnProjets" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="   📁  Gestion Projets" />
                <Button fx:id="btnCredits" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="   💰  Liste des Crédits" />
                <Button fx:id="btnNegociations" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="   🤝  Négociations" />
            </children>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f8f9fa;">
            <content>
                <VBox fx:id="mainContent" spacing="30.0" style="-fx-background-color: #f8f9fa;">
                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                    <children>

                        <HBox spacing="20.0">
                            <children>
                                <VBox prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                    <children>
                                        <Label text="Nombre des Crédits postulés" textFill="#7f8c8d" />
                                        <Label fx:id="statTotalCredits" text="128" textFill="#2c3e50"><font><Font name="System Bold" size="28.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                    <children>
                                        <Label text="Négociations " textFill="#7f8c8d" />
                                        <Label fx:id="statTotalNegos" text="42" textFill="#e67e22"><font><Font name="System Bold" size="28.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                    <children>
                                        <Label text="Nombre des Projets postulés " textFill="#7f8c8d" />
                                        <Label fx:id="statTotalProjets" text="15" textFill="#27ae60"><font><Font name="System Bold" size="28.0" /></font></Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                            <children>
                                <Label text="Activité Récente" textFill="#2c3e50">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </Label>
                                <TableView fx:id="tableRecentActivity" prefHeight="300.0" style="-fx-background-color: transparent;">
                                    <columns>
                                        <TableColumn fx:id="colAction" prefWidth="250.0" text="Action" />
                                        <TableColumn fx:id="colMontant" prefWidth="150.0" text="Montant" />
                                        <TableColumn fx:id="colStatus" prefWidth="150.0" text="Statut" />
                                        <TableColumn fx:id="colDate" prefWidth="150.0" text="Date" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>