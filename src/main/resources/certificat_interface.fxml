<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox spacing="20" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.CertificatController">
    <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

    <HBox spacing="20" alignment="CENTER">
        <VBox alignment="CENTER" prefWidth="250" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label text="TOTAL ÉMIS" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
            <Label fx:id="lblTotalCertifs" text="0" style="-fx-font-size: 26; -fx-font-weight: bold;"/>
        </VBox>
        <VBox alignment="CENTER" prefWidth="250" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label text="ÉMIS CE MOIS" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
            <Label fx:id="lblMonthCertifs" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
        </VBox>
        <VBox alignment="CENTER" prefWidth="250" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label text="MENTION DOMINANTE" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
            <Label fx:id="lblTopMention" text="-" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #f1c40f;"/>
        </VBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="➕ Créer Certificat" onAction="#handleAddManual" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;"/>
        <Button text="🗑 Supprimer" onAction="#handleDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Archives Certificats" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    </HBox>

    <TableView fx:id="certTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10;">
        <columns>
            <TableColumn fx:id="colEleve" text="👨‍🎓 Élève" prefWidth="200"/>

            <TableColumn fx:id="colFormation" text="📚 Formation" prefWidth="200"/>

            <TableColumn fx:id="colMention" text="🏅 Mention" prefWidth="120"/>
            <TableColumn fx:id="colCode" text="🔑 Code" prefWidth="100"/>
            <TableColumn fx:id="colDate" text="📅 Date" prefWidth="120"/>

            <TableColumn fx:id="colActions" text="📄 PDF" prefWidth="100"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</VBox>