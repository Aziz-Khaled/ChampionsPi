<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane prefWidth="1250" prefHeight="750" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.InterfaceController">
   <center>
      <VBox spacing="25" style="-fx-background-color: #f8f9fa; -fx-padding: 30;">
         <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox>
               <Label text="Programmes de Formation" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
               <Label text="Système de gestion certifié FinTech" style="-fx-text-fill: #95a5a6;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" promptText="🔍 Rechercher une formation..." style="-fx-pref-width: 300; -fx-background-radius: 25; -fx-padding: 10;"/>
            <Button fx:id="btnAdd" text="+ Nouvelle Formation" onAction="#handleAdding" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 12 25; -fx-cursor: hand;"/>
         </HBox>
         <TableView fx:id="tableView" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-border-color: #dcdde1; -fx-border-radius: 10;">
            <columns>
               <TableColumn fx:id="idColumn" text="ID" prefWidth="50" />
               <TableColumn fx:id="titreColumn" text="Titre" prefWidth="200" />
               <TableColumn fx:id="domaineColumn" text="Domaine" prefWidth="150" />
               <TableColumn fx:id="prixColumn" text="Prix (DT)" prefWidth="100" />
               <TableColumn fx:id="dateDebutColumn" text="Date Début" prefWidth="120" />
               <TableColumn fx:id="statutColumn" text="Statut" prefWidth="110" />
               <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="220" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
         </TableView>
      </VBox>
   </center>
</BorderPane>