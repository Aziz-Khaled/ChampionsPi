<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane prefWidth="1250" prefHeight="750" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.InterfaceController">
   <center>
      <VBox spacing="25" style="-fx-background-color: #f8f9fa; -fx-padding: 30;">
         <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox>
               <Label text="Gestion Back-Office Formations" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
               <Label text="Champions Academy - Administration" style="-fx-text-fill: #95a5a6;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="📊 Voir Stats" onAction="#showStats" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand;"/>
            <TextField fx:id="searchField" promptText="🔍 Rechercher..." style="-fx-pref-width: 250; -fx-background-radius: 25;"/>
            <Button fx:id="btnAdd" text="+ Ajouter" onAction="#handleAdding" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20;"/>
         </HBox>
         <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="titreColumn" text="Titre" prefWidth="250" />
               <TableColumn fx:id="domaineColumn" text="Domaine" prefWidth="200" />
               <TableColumn fx:id="prixColumn" text="Prix (DT)" prefWidth="100" />
               <TableColumn fx:id="dateDebutColumn" text="Date Début" prefWidth="150" />
               <TableColumn fx:id="statutColumn" text="Statut" prefWidth="150" />
               <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="250" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
         </TableView>
      </VBox>
   </center>
</BorderPane>