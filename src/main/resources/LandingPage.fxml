<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox prefHeight="800.0" prefWidth="1100.0" styleClass="main-container" stylesheets="@/Styles/Styless.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.AuthService">
    <children>
        <VBox alignment="CENTER_LEFT" prefWidth="420.0" spacing="35.0" styleClass="brand-section" HBox.hgrow="NEVER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <StackPane styleClass="logo-box" prefWidth="45" prefHeight="45">
                            <children>
                                <Label style="-fx-font-family: 'System'; -fx-font-style: italic; -fx-font-weight: 900; -fx-font-size: 22;" text="C" textFill="WHITE" />
                            </children>
                        </StackPane>
                        <Label styleClass="brand-title" text="CHAMPIONS." />
                    </children>
                </HBox>

                <VBox spacing="15.0">
                    <children>
                        <Label styleClass="brand-headline" text="Start your financial legacy." wrapText="true" />
                        <Label styleClass="brand-subtext" text="Join the elite circle of investors and traders in the most secure crypto ecosystem." wrapText="true" />
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox spacing="10" styleClass="stat-card" style="-fx-padding: 15; -fx-background-radius: 15;">
                    <children>
                        <Label style="-fx-text-fill: #2E5BFF; -fx-font-weight: bold;" text="SECURITY NOTE" />
                        <Label styleClass="brand-subtext" style="-fx-font-size: 12;" text="All accounts require manual admin approval to ensure platform integrity." wrapText="true" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <VBox alignment="CENTER" styleClass="form-section" HBox.hgrow="ALWAYS">
            <children>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" maxWidth="550.0">
                    <content>
                        <VBox spacing="30.0" style="-fx-padding: 20;">
                            <children>
                                <VBox spacing="8.0">
                                    <children>
                                        <Label styleClass="brand-title" style="-fx-font-size: 32;" text="Create Account" />
                                        <Label styleClass="brand-subtext" text="Fill in your details to begin the verification process." />
                                    </children>
                                </VBox>

                                <GridPane hgap="20.0" vgap="20.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                    </columnConstraints>
                                    <children>
                                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="input-label" text="Nom" />
                                                <TextField fx:id="TF_Nom" promptText="Doe" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="input-label" text="Prénom" />
                                                <TextField fx:id="TF_Prenom" promptText="John" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                            <children>
                                                <Label styleClass="input-label" text="Email Address" />
                                                <TextField fx:id="TF_Email" promptText="john.doe@example.com" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <children>
                                                <Label styleClass="input-label" text="Téléphone" />
                                                <TextField fx:id="TF_Telephone" promptText="+216 ..." />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <children>
                                                <Label styleClass="input-label" text="Mot de passe" />
                                                <PasswordField fx:id="TF_Password" promptText="••••••••" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <VBox spacing="10.0">
                                    <children>
                                        <Label styleClass="input-label" text="How will you use this platform?" />
                                        <ComboBox fx:id="combobox_role" maxWidth="Infinity" promptText="Select your role" />
                                    </children>
                                </VBox>

                                <HBox spacing="20.0">
                                    <children>
                                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="input-label" text="Identity File" />
                                                <Button fx:id="Identity_Button" maxWidth="Infinity" styleClass="button-secondary" style="-fx-border-color: #333; -fx-border-style: dashed; -fx-border-radius: 10; -fx-padding: 15;" text="Upload ID" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="input-label" text="Personal Image" />
                                                <Button fx:id="personalImage_button" maxWidth="Infinity" styleClass="button-secondary" style="-fx-border-color: #333; -fx-border-style: dashed; -fx-border-radius: 10; -fx-padding: 15;" text="Upload Photo" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox spacing="15.0" alignment="CENTER">
                                    <children>
                                        <Button fx:id="signUpButton" maxWidth="Infinity" styleClass="button-primary" text="Submit for Approval" />
                                        <HBox alignment="CENTER" spacing="8">
                                            <children>
                                                <Label styleClass="brand-subtext" text="Already have an account?" />
                                                <Button fx:id="Login_Button" styleClass="button-secondary" text="Login" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</HBox>