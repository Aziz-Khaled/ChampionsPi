<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox prefHeight="850.0" prefWidth="1250.0" style="-fx-background-color: #0b0e11;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.TradingDashboard">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="20" style="-fx-background-color: #161a1e; -fx-padding: 0 20; -fx-border-color: #2b3139; -fx-border-width: 0 0 1 0;">
            <children>
                <Label text="🏆 CHAMPIONS FINTECH" style="-fx-text-fill: #fcd535; -fx-font-weight: bold; -fx-font-size: 18;" />
                <Separator orientation="VERTICAL" prefHeight="30.0" opacity="0.1" />

                <Button onAction="#showMarket" text="MARCHÉ" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" />
                <Button onAction="#showHistory" text="MON HISTORIQUE" style="-fx-background-color: transparent; -fx-text-fill: #848e9c; -fx-cursor: hand; -fx-font-weight: bold;" />

                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#openBotWindow" text="🤖 BOT ENGINE" style="-fx-background-color: #fcd535; -fx-text-fill: #0b0e11; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 8 15; -fx-cursor: hand;" />
            </children>
        </HBox>

        <HBox VBox.vgrow="ALWAYS">
            <children>
                <VBox prefWidth="300.0" spacing="15.0" style="-fx-background-color: #161a1e; -fx-padding: 15; -fx-border-color: #2b3139; -fx-border-width: 0 1 0 0;">
                    <children>
                        <VBox spacing="5" style="-fx-background-color: #1e2329; -fx-padding: 15; -fx-background-radius: 8;">
                            <Label text="SOLDE ESTIMÉ" style="-fx-text-fill: #848e9c; -fx-font-size: 11; -fx-font-weight: bold;" />
                            <Label fx:id="lblBalance" text="0.00 USDT" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" />
                            <Label fx:id="lblBalanceTND" text="0.00 TND" style="-fx-text-fill: #848e9c; -fx-font-size: 13;" />
                        </VBox>

                        <Label text="LISTE DES MARCHÉS" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 0 0 0;" />

                        <TableView fx:id="tableAssets" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-base: #161a1e; -fx-control-inner-background: #161a1e;">
                            <columns>
                                <TableColumn fx:id="colSymbol" prefWidth="100.0" text="Paire" />
                                <TableColumn fx:id="colPrice" prefWidth="170.0" text="Prix (USDT)" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <StackPane HBox.hgrow="ALWAYS">
                    <children>
                        <VBox fx:id="paneMarket" spacing="10" style="-fx-padding: 15;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <VBox>
                                        <Label fx:id="lblSelected" text="Sélectionnez un actif" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" />
                                        <Label fx:id="lblAdvice" text="Signal IA: En attente..." style="-fx-text-fill: #2962ff; -fx-font-weight: bold;" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <VBox alignment="CENTER_RIGHT">
                                        <Label text="Variation PnL" style="-fx-text-fill: #848e9c; -fx-font-size: 11;" />
                                        <Label fx:id="lblPnL" text="0.00%" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;" />
                                    </VBox>
                                </HBox>

                                <LineChart fx:id="priceChart" animated="false" createSymbols="false" legendVisible="false" prefHeight="400.0" style="-fx-background-color: #161a1e; -fx-background-radius: 8; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                                    <xAxis><CategoryAxis side="BOTTOM" tickLabelFill="#848e9c" /></xAxis>
                                    <yAxis><NumberAxis side="RIGHT" tickLabelFill="#848e9c" forceZeroInRange="false" /></yAxis>
                                </LineChart>

                                <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #161a1e; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #2b3139;">
                                    <children>
                                        <VBox spacing="5">
                                            <Label text="MODE D'ORDRE" style="-fx-text-fill: #848e9c; -fx-font-size: 10;" />
                                            <ComboBox fx:id="comboOrderMode" prefHeight="40" prefWidth="120" style="-fx-background-color: #2b3139; -fx-text-fill: white;" />
                                        </VBox>
                                        <VBox spacing="5">
                                            <Label text="PRIX CIBLE (LIMIT)" style="-fx-text-fill: #848e9c; -fx-font-size: 10;" />
                                            <TextField fx:id="txtTargetPrice" prefHeight="40" prefWidth="130" promptText="0.00" style="-fx-background-color: #2b3139; -fx-text-fill: white; -fx-border-color: #474d57;" />
                                        </VBox>
                                        <VBox spacing="5">
                                            <Label text="QUANTITÉ" style="-fx-text-fill: #848e9c; -fx-font-size: 10;" />
                                            <TextField fx:id="txtQty" prefHeight="40" prefWidth="130" promptText="0.00" style="-fx-background-color: #2b3139; -fx-text-fill: white; -fx-border-color: #474d57;" />
                                        </VBox>
                                        <VBox alignment="CENTER_LEFT" prefWidth="140" spacing="5">
                                            <Label text="TOTAL À PAYER" style="-fx-text-fill: #848e9c; -fx-font-size: 10;" />
                                            <Label fx:id="lblTotal" text="0.00 USDT" style="-fx-text-fill: #fcd535; -fx-font-size: 18; -fx-font-weight: bold;" />
                                        </VBox>

                                        <Region HBox.hgrow="ALWAYS" />

                                        <Button onAction="#onBuy" prefHeight="50" prefWidth="140" text="ACHETER" style="-fx-background-color: #0ecb81; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                                        <Button onAction="#onSell" prefHeight="50" prefWidth="140" text="VENDRE" style="-fx-background-color: #f6465d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox fx:id="paneHistory" spacing="15" style="-fx-padding: 25; -fx-background-color: #0b0e11;" visible="false">
                            <children>
                                <Label text="HISTORIQUE DES TRANSACTIONS" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" />
                                <TableView fx:id="tableHistory" style="-fx-base: #161a1e; -fx-control-inner-background: #161a1e;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colHistSymbol" prefWidth="150.0" text="Actif" />
                                        <TableColumn fx:id="colHistType" prefWidth="120.0" text="Type" />
                                        <TableColumn fx:id="colHistQty" prefWidth="150.0" text="Quantité" />
                                        <TableColumn fx:id="colHistPrice" prefWidth="180.0" text="Prix d'exécution" />
                                        <TableColumn fx:id="colHistStatus" prefWidth="150.0" text="Statut" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </HBox>
    </children>
</VBox>