<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox prefHeight="850.0" prefWidth="1250.0" style="-fx-background-color: #0b0e11;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.TradingDashboard">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="20" style="-fx-background-color: #161a1e; -fx-padding: 0 20; -fx-border-color: #2b3139; -fx-border-width: 0 0 1 0;">
            <children>
                <Label style="-fx-text-fill: #fcd535; -fx-font-weight: bold; -fx-font-size: 18;" text="🏆 CHAMPIONS FINTECH" />
                <Separator opacity="0.1" orientation="VERTICAL" prefHeight="30.0" />
                <Button onAction="#showMarket" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="MARKET" />
                <Button onAction="#showHistory" style="-fx-background-color: transparent; -fx-text-fill: #848e9c; -fx-cursor: hand; -fx-font-weight: bold;" text="MY HISTORY" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#openBotWindow" style="-fx-background-color: #fcd535; -fx-text-fill: #0b0e11; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 8 15; -fx-cursor: hand;" text="🤖 AI BOT ENGINE" />
            </children>
        </HBox>

        <HBox VBox.vgrow="ALWAYS">
            <children>
                <VBox prefWidth="300.0" spacing="15.0" style="-fx-background-color: #161a1e; -fx-padding: 15; -fx-border-color: #2b3139; -fx-border-width: 0 1 0 0;">
                    <children>
                        <VBox spacing="5" style="-fx-background-color: #1e2329; -fx-padding: 15; -fx-background-radius: 8;">
                            <Label style="-fx-text-fill: #848e9c; -fx-font-size: 11; -fx-font-weight: bold;" text="ESTIMATED BALANCE" />
                            <Label fx:id="lblBalance" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="0.00 USDT" />
                            <Label fx:id="lblBalanceTND" style="-fx-text-fill: #848e9c; -fx-font-size: 13;" text="0.00 TND" />
                        </VBox>
                        <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="MARKET WATCH" />
                        <TableView fx:id="tableAssets" style="-fx-background-color: transparent; -fx-base: #161a1e;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colSymbol" prefWidth="100.0" text="Pair" />
                                <TableColumn fx:id="colPrice" prefWidth="170.0" text="Price (USDT)" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <StackPane HBox.hgrow="ALWAYS">
                    <children>
                        <HBox fx:id="paneMarket" spacing="10" style="-fx-padding: 15;">
                            <children>
                                <VBox spacing="10" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="20">
                                            <VBox>
                                                <Label fx:id="lblSelected" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Select an Asset" />
                                                <Label fx:id="lblAdvice" style="-fx-text-fill: #2962ff; -fx-font-weight: bold;" text="AI Signal: Waiting..." />
                                            </VBox>
                                            <Region HBox.hgrow="ALWAYS" />
                                            <VBox alignment="CENTER_RIGHT">
                                                <Label style="-fx-text-fill: #848e9c; -fx-font-size: 11;" text="Live PnL" />
                                                <Label fx:id="lblPnL" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;" text="0.00%" />
                                            </VBox>
                                        </HBox>

                                        <VBox style="-fx-background-color: #161a1e; -fx-background-radius: 8; -fx-overflow-hidden: true;" VBox.vgrow="ALWAYS">
                                            <children>
                                                <WebView fx:id="chartWebView" prefHeight="-1.0" prefWidth="-1.0" VBox.vgrow="ALWAYS" />
                                            </children>
                                        </VBox>

                                        <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #161a1e; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #2b3139;">
                                            <children>
                                                <VBox spacing="5">
                                                    <Label style="-fx-text-fill: #848e9c; -fx-font-size: 10;" text="MODE" />
                                                    <ComboBox fx:id="comboOrderMode" prefHeight="40" prefWidth="100" style="-fx-background-color: #2b3139; -fx-text-fill: white;" />
                                                </VBox>
                                                <VBox spacing="5">
                                                    <Label style="-fx-text-fill: #848e9c; -fx-font-size: 10;" text="STOP LOSS / TARGET" />
                                                    <TextField fx:id="txtTargetPrice" prefHeight="40" prefWidth="110" promptText="0.00" style="-fx-background-color: #2b3139; -fx-text-fill: white;" />
                                                </VBox>
                                                <VBox spacing="5">
                                                    <Label style="-fx-text-fill: #848e9c; -fx-font-size: 10;" text="QUANTITY" />
                                                    <HBox spacing="5">
                                                        <TextField fx:id="txtQty" prefHeight="40" prefWidth="100" promptText="0.00" style="-fx-background-color: #2b3139; -fx-text-fill: white;" />
                                                        <Button onAction="#onSuggestQuantity" prefHeight="40" style="-fx-background-color: #2962ff; -fx-text-fill: white; -fx-font-size: 9; -fx-font-weight: bold;" text="SUGGEST" />
                                                    </HBox>
                                                </VBox>
                                                <VBox alignment="CENTER_LEFT" prefWidth="160" spacing="5">
                                                    <Label style="-fx-text-fill: #848e9c; -fx-font-size: 10;" text="ESTIMATED TOTAL" />
                                                    <Label fx:id="lblTotal" style="-fx-text-fill: #fcd535; -fx-font-size: 16; -fx-font-weight: bold;" text="0.00 USDT" />
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button onAction="#onBuy" prefHeight="50" prefWidth="120" style="-fx-background-color: #0ecb81; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="BUY" />
                                                <Button onAction="#onSell" prefHeight="50" prefWidth="120" style="-fx-background-color: #f6465d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="SELL" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox prefWidth="250.0" spacing="10" style="-fx-background-color: #161a1e; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #2b3139;">
                                    <children>
                                        <Label style="-fx-text-fill: #fcd535; -fx-font-weight: bold;" text="🔥 LIVE NEWS" />
                                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                                            <content>
                                                <VBox fx:id="vboxNews" spacing="12" style="-fx-background-color: transparent;" />
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox fx:id="paneHistory" spacing="15" style="-fx-background-color: #0b0e11; -fx-padding: 25;" visible="false">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="Trade HISTORY" />
                                <TableView fx:id="tableHistory" style="-fx-base: #161a1e; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colHistSymbol" prefWidth="150.0" text="Asset" />
                                        <TableColumn fx:id="colHistType" prefWidth="120.0" text="Side" />
                                        <TableColumn fx:id="colHistQty" prefWidth="150.0" text="Quantity" />
                                        <TableColumn fx:id="colHistPrice" prefWidth="180.0" text="Executed Price" />
                                        <TableColumn fx:id="colHistStatus" prefWidth="150.0" text="Status" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </HBox>
    </children>
</VBox>