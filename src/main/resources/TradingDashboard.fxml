<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>

<HBox prefHeight="700.0" prefWidth="1150.0" style="-fx-background-color: #131722;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.TradingDashboard">
    <children>
        <VBox prefWidth="300.0" spacing="20.0" style="-fx-background-color: #1e222d; -fx-padding: 20;">
            <children>
                <Label text="WALLET BALANCE" style="-fx-text-fill: #b2b5be; -fx-font-size: 12;" />
                <Label fx:id="lblBalance" text="0.00 USDT" style="-fx-text-fill: #00ff88; -fx-font-size: 24; -fx-font-weight: bold;" />
                <Label fx:id="lblBalanceTND" text="0.00 TND" style="-fx-text-fill: white;" />
                <Separator opacity="0.1" />
                <Label text="LIVE MARKET" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                <TableView fx:id="tableAssets" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSymbol" text="Symbol" prefWidth="100" />
                        <TableColumn fx:id="colPrice" text="Price" prefWidth="150" />
                    </columns>
                </TableView>
            </children>
        </VBox>

        <VBox spacing="20.0" HBox.hgrow="ALWAYS" style="-fx-padding: 20;">
            <children>
                <HBox spacing="20">
                    <Label fx:id="lblSelected" text="SELECT ASSET" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" />
                    <Label fx:id="lblAdvice" text="Signal: ---" style="-fx-text-fill: #2962ff; -fx-font-size: 18;" />
                </HBox>

                <LineChart fx:id="priceChart" animated="false" createSymbols="false" VBox.vgrow="ALWAYS">
                    <xAxis><CategoryAxis side="BOTTOM" tickLabelFill="WHITE" /></xAxis>
                    <yAxis><NumberAxis side="LEFT" tickLabelFill="WHITE" forceZeroInRange="false" /></yAxis>
                </LineChart>

                <VBox spacing="15" style="-fx-background-color: #1e222d; -fx-padding: 20; -fx-background-radius: 10;">
                    <children>
                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <TextField fx:id="txtQty" promptText="Quantity" prefHeight="40" prefWidth="150" />
                            <Label fx:id="lblPnL" text="0.00 %" style="-fx-font-size: 20; -fx-font-weight: bold;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTotal" text="Total: 0.00 USDT" style="-fx-text-fill: white; -fx-font-size: 16;" />
                        </HBox>
                        <HBox spacing="15">
                            <Button onAction="#onBuy" text="BUY / LONG" prefHeight="45" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #089981; -fx-text-fill: white; -fx-font-weight: bold;" />
                            <Button onAction="#onSell" text="SELL / SHORT" prefHeight="45" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #f23645; -fx-text-fill: white; -fx-font-weight: bold;" />
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>