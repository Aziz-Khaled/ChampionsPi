<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox prefHeight="850.0" prefWidth="1250.0" style="-fx-background-color: #0A0E1A;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.TradingDashboard">
    <stylesheets>
        <URL value="@/css/style.css" />
    </stylesheets>

    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="20" style="-fx-background-color: #111827; -fx-padding: 0 25; -fx-border-color: #1E2D45; -fx-border-width: 0 0 1 0;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <children>
                        <ImageView fitHeight="40.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="logo .png" />
                            </image>
                        </ImageView>

                        <Button onAction="#handleBackToWallet" style="-fx-background-color: rgba(0, 212, 255, 0.1); -fx-text-fill: #00D4FF; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-color: #00D4FF; -fx-border-radius: 10; -fx-cursor: hand; -fx-padding: 5 12;" text="← BACK" />
                    </children>
                </HBox>

                <Label style="-fx-text-fill: #00D4FF; -fx-font-weight: 900; -fx-font-size: 18; -fx-letter-spacing: 1;" text="CHAMPIONS FINTECH" />

                <Separator opacity="0.1" orientation="VERTICAL" prefHeight="30.0" />

                <Button onAction="#showMarket" style="-fx-background-color: transparent; -fx-text-fill: #F0F4FF; -fx-font-weight: bold; -fx-cursor: hand;" text="MARKET" />
                <Button onAction="#showHistory" style="-fx-background-color: transparent; -fx-text-fill: #8B9AB5; -fx-font-weight: bold; -fx-cursor: hand;" text="MY HISTORY" />
                <Button onAction="#showAIChat" style="-fx-background-color: transparent; -fx-text-fill: #8B9AB5; -fx-font-weight: bold; -fx-cursor: hand;" text="AI ANALYST" />

                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#openBotWindow" style="-fx-background-color: linear-gradient(to right, #00D4FF, #7C3AED); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="🤖 AI BOT ENGINE" />
            </children>
        </HBox>

        <HBox VBox.vgrow="ALWAYS">
            <children>
                <VBox prefWidth="300.0" spacing="15.0" style="-fx-background-color: #111827; -fx-padding: 15; -fx-border-color: #1E2D45; -fx-border-width: 0 1 0 0;">
                    <children>
                        <VBox spacing="10" style="-fx-background-color: #1A2235; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #1E2D45;">
                            <children>
                                <Label style="-fx-text-fill: #8B9AB5; -fx-font-size: 10; -fx-font-weight: bold;" text="SELECT TRADING WALLET" />
                                <ComboBox fx:id="comboWalletSelection" prefWidth="270" promptText="Select Wallet" style="-fx-background-color: #0A0E1A; -fx-border-color: #1E2D45; -fx-text-fill: white;" />

                                <Label style="-fx-text-fill: #8B9AB5; -fx-font-size: 10; -fx-font-weight: bold; -fx-padding: 10 0 0 0;" text="WALLET USDT BALANCE" />
                                <Label fx:id="lblBalance" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: 800;" text="0.00 USDT" />
                                <Label fx:id="lblBalanceTND" style="-fx-text-fill: #00FFA3; -fx-font-size: 13;" text="0.00 TND" />
                            </children>
                        </VBox>

                        <TableView fx:id="tableAssets" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colSymbol" prefWidth="100.0" text="Pair" />
                                <TableColumn fx:id="colPrice" prefWidth="170.0" text="Price (USDT)" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <StackPane HBox.hgrow="ALWAYS">
                    <children>
                        <VBox fx:id="paneMarket" spacing="15" style="-fx-padding: 15;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <VBox>
                                        <Label fx:id="lblSelected" style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: 800;" text="Select an Asset" />
                                        <Label fx:id="lblAdvice" style="-fx-text-fill: #00D4FF; -fx-font-weight: bold; -fx-font-size: 12;" text="AI Signal: Waiting..." />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <VBox alignment="CENTER_RIGHT">
                                        <Label style="-fx-text-fill: #8B9AB5; -fx-font-size: 11;" text="Live PnL" />
                                        <Label fx:id="lblPnL" style="-fx-font-size: 24; -fx-font-weight: 800; -fx-text-fill: #00FFA3;" text="0.00%" />
                                    </VBox>
                                </HBox>

                                <HBox spacing="15" VBox.vgrow="ALWAYS">
                                    <children>
                                        <VBox style="-fx-background-color: #111827; -fx-background-radius: 12; -fx-border-color: #1E2D45; -fx-overflow: hidden;" HBox.hgrow="ALWAYS">
                                            <WebView fx:id="chartWebView" VBox.vgrow="ALWAYS" />
                                        </VBox>
                                        <VBox prefWidth="260.0" spacing="12" style="-fx-background-color: #111827; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #1E2D45;" VBox.vgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #00D4FF; -fx-font-weight: bold; -fx-letter-spacing: 1;" text="🔥 LIVE NEWS" />
                                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                                                <content>
                                                    <VBox fx:id="vboxNews" spacing="12" style="-fx-background-color: transparent;" />
                                                </content>
                                            </ScrollPane>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER" spacing="12" style="-fx-background-color: #111827; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #1E2D45;">
                                    <children>
                                        <VBox spacing="5">
                                            <Label style="-fx-text-fill: #8B9AB5; -fx-font-size: 10;" text="MODE" />
                                            <ComboBox fx:id="comboOrderMode" prefHeight="40" prefWidth="110" style="-fx-background-color: #0A0E1A; -fx-border-color: #1E2D45; -fx-text-fill: white;" />
                                        </VBox>
                                        <VBox spacing="5">
                                            <Label style="-fx-text-fill: #8B9AB5; -fx-font-size: 10;" text="STOP LOSS / TARGET" />
                                            <TextField fx:id="txtTargetPrice" prefHeight="40" prefWidth="120" style="-fx-background-color: #0A0E1A; -fx-border-color: #1E2D45; -fx-text-fill: white;" />
                                        </VBox>
                                        <VBox spacing="5">
                                            <Label style="-fx-text-fill: #8B9AB5; -fx-font-size: 10;" text="QUANTITY" />
                                            <HBox spacing="5">
                                                <TextField fx:id="txtQty" prefHeight="40" prefWidth="100" style="-fx-background-color: #0A0E1A; -fx-border-color: #1E2D45; -fx-text-fill: white;" />
                                                <Button onAction="#onSuggestQuantity" prefHeight="40" style="-fx-background-color: rgba(0, 212, 255, 0.1); -fx-text-fill: #00D4FF; -fx-border-color: #00D4FF; -fx-font-size: 9; -fx-font-weight: bold; -fx-cursor: hand;" text="SUGGEST" />
                                            </HBox>
                                        </VBox>
                                        <VBox alignment="CENTER_LEFT" prefWidth="160" spacing="2">
                                            <Label style="-fx-text-fill: #8B9AB5; -fx-font-size: 10;" text="ESTIMATED TOTAL" />
                                            <Label fx:id="lblTotal" style="-fx-text-fill: #00FFA3; -fx-font-size: 18; -fx-font-weight: 800;" text="0.00 USDT" />
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button onAction="#onBuy" prefHeight="50" prefWidth="130" style="-fx-background-color: #00FFA3; -fx-text-fill: #0A0E1A; -fx-font-weight: 900; -fx-background-radius: 8; -fx-cursor: hand;" text="BUY" />
                                        <Button onAction="#onSell" prefHeight="50" prefWidth="130" style="-fx-background-color: #FF4757; -fx-text-fill: white; -fx-font-weight: 900; -fx-background-radius: 8; -fx-cursor: hand;" text="SELL" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox fx:id="paneHistory" spacing="15" style="-fx-background-color: #0A0E1A; -fx-padding: 25;" visible="false">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: 800;" text="TRADE HISTORY" />
                                <TableView fx:id="tableHistory" style="-fx-background-color: transparent; -fx-border-color: #1E2D45;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colHistSymbol" text="Asset" />
                                        <TableColumn fx:id="colHistType" text="Side" />
                                        <TableColumn fx:id="colHistQty" text="Quantity" />
                                        <TableColumn fx:id="colHistPrice" text="Price" />
                                        <TableColumn fx:id="colHistStatus" text="Status" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <VBox fx:id="paneAIChat" spacing="15" style="-fx-background-color: #0A0E1A; -fx-padding: 25;" visible="false">
                            <children>
                                <Label style="-fx-text-fill: #00D4FF; -fx-font-size: 24; -fx-font-weight: 800;" text="🤖 AI TRADING ANALYST" />
                                <TextArea fx:id="chatArea" editable="false" style="-fx-control-inner-background: #111827; -fx-text-fill: #F0F4FF; -fx-font-family: 'Consolas'; -fx-border-color: #1E2D45; -fx-background-radius: 8; -fx-border-radius: 8;" wrapText="true" VBox.vgrow="ALWAYS" />
                                <HBox spacing="10">
                                    <children>
                                        <TextField fx:id="txtChatInput" onAction="#onSendMessage" promptText="Ask Gemini..." style="-fx-background-color: #1A2235; -fx-text-fill: white; -fx-border-color: #1E2D45; -fx-padding: 12; -fx-background-radius: 20;" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnSend" onAction="#onSendMessage" prefHeight="45" prefWidth="100" style="-fx-background-color: #00D4FF; -fx-text-fill: #0A0E1A; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;" text="SEND" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" prefHeight="35.0" spacing="15" style="-fx-background-color: #111827; -fx-padding: 0 15; -fx-border-color: #1E2D45; -fx-border-width: 1 0 0 0;">
            <children>
                <HBox alignment="CENTER" spacing="5">
                    <Circle radius="3" fill="#00FFA3" />
                    <Label style="-fx-text-fill: #00FFA3; -fx-font-size: 10; -fx-font-weight: bold;" text="LIVE MARKET" />
                </HBox>
                <Separator orientation="VERTICAL" prefHeight="15.0" style="-fx-opacity: 0.1;" />
                <HBox fx:id="tickerContainer" alignment="CENTER_LEFT" spacing="30" />
            </children>
        </HBox>
    </children>
</VBox>