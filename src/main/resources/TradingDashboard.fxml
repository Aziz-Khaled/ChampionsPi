<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox prefHeight="850.0" prefWidth="1250.0" style="-fx-background-color: #0b0e11;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.TradingDashboard">
    <stylesheets>
        <URL value="@/css/style.css" />
    </stylesheets>

    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20" style="-fx-background-color: #161a1e; -fx-padding: 0 20; -fx-border-color: #2b3139; -fx-border-width: 0 0 1 0;">
            <children>
                <Label style="-fx-text-fill: #fcd535; -fx-font-weight: bold; -fx-font-size: 18;" text="🏆 CHAMPIONS FINTECH" />
                <Separator opacity="0.1" orientation="VERTICAL" prefHeight="30.0" />
                <Button onAction="#showMarket" styleClass="nav-button" text="MARKET" />
                <Button onAction="#showHistory" styleClass="nav-button" text="MY HISTORY" />
                <Button onAction="#showAIChat" styleClass="nav-button" text="AI ANALYST" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#openBotWindow" style="-fx-background-color: #fcd535; -fx-text-fill: #0b0e11; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 8 15;" text="🤖 AI BOT ENGINE" />
            </children>
        </HBox>

        <HBox VBox.vgrow="ALWAYS">
            <children>
                <VBox prefWidth="300.0" spacing="15.0" style="-fx-background-color: #161a1e; -fx-padding: 15; -fx-border-color: #2b3139; -fx-border-width: 0 1 0 0;">
                    <children>
                        <VBox spacing="5" style="-fx-background-color: #1e2329; -fx-padding: 15; -fx-background-radius: 8;">
                            <VBox spacing="5" style="-fx-background-color: #1e2329; -fx-padding: 15; -fx-background-radius: 8;">
                                <Label style="-fx-text-fill: #848e9c; -fx-font-size: 11; -fx-font-weight: bold;" text="SELECT TRADING WALLET" />
                                <ComboBox fx:id="comboWalletSelection" prefWidth="270" promptText="Select Wallet" style="-fx-background-color: #2b3139; -fx-text-fill: white;" />

                                <Label style="-fx-text-fill: #848e9c; -fx-font-size: 11; -fx-font-weight: bold; -fx-padding: 10 0 0 0;" text="WALLET USDT BALANCE" />
                                <Label fx:id="lblBalance" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="0.00 USDT" />
                                <Label fx:id="lblBalanceTND" style="-fx-text-fill: #848e9c; -fx-font-size: 13;" text="0.00 TND" />
                            </VBox>
                        </VBox>
                        <TableView fx:id="tableAssets" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colSymbol" prefWidth="100.0" text="Pair" />
                                <TableColumn fx:id="colPrice" prefWidth="170.0" text="Price (USDT)" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <StackPane HBox.hgrow="ALWAYS">
                    <children>
                        <VBox fx:id="paneMarket" spacing="10" style="-fx-padding: 15;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <VBox>
                                        <Label fx:id="lblSelected" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Select an Asset" />
                                        <Label fx:id="lblAdvice" style="-fx-text-fill: #2962ff; -fx-font-weight: bold;" text="AI Signal: Waiting..." />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <VBox alignment="CENTER_RIGHT">
                                        <Label style="-fx-text-fill: #848e9c; -fx-font-size: 11;" text="Live PnL" />
                                        <Label fx:id="lblPnL" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;" text="0.00%" />
                                    </VBox>
                                </HBox>
                                <HBox spacing="10" VBox.vgrow="ALWAYS">
                                    <children>
                                        <VBox style="-fx-background-color: #161a1e; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                                            <WebView fx:id="chartWebView" VBox.vgrow="ALWAYS" />
                                        </VBox>
                                        <VBox prefWidth="250.0" spacing="10" style="-fx-background-color: #161a1e; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #2b3139;" VBox.vgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #fcd535; -fx-font-weight: bold;" text="🔥 LIVE NEWS" />
                                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                                <content>
                                                    <VBox fx:id="vboxNews" spacing="12" style="-fx-background-color: transparent;" />
                                                </content>
                                            </ScrollPane>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #161a1e; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #2b3139;">
                                    <children>
                                        <VBox spacing="5"><Label style="-fx-text-fill: #848e9c; -fx-font-size: 10;" text="MODE" /><ComboBox fx:id="comboOrderMode" prefHeight="40" prefWidth="100" /></VBox>
                                        <VBox spacing="5"><Label style="-fx-text-fill: #848e9c; -fx-font-size: 10;" text="STOP LOSS / TARGET" /><TextField fx:id="txtTargetPrice" prefHeight="40" prefWidth="110" style="-fx-background-color: #2b3139; -fx-text-fill: white;" /></VBox>
                                        <VBox spacing="5">
                                            <Label style="-fx-text-fill: #848e9c; -fx-font-size: 10;" text="QUANTITY" />
                                            <HBox spacing="5">
                                                <TextField fx:id="txtQty" prefHeight="40" prefWidth="100" style="-fx-background-color: #2b3139; -fx-text-fill: white;" />
                                                <Button onAction="#onSuggestQuantity" prefHeight="40" style="-fx-background-color: #2962ff; -fx-text-fill: white; -fx-font-size: 9;" text="SUGGEST" />
                                            </HBox>
                                        </VBox>
                                        <VBox alignment="CENTER_LEFT" prefWidth="150" spacing="5"><Label style="-fx-text-fill: #848e9c; -fx-font-size: 10;" text="ESTIMATED TOTAL" /><Label fx:id="lblTotal" style="-fx-text-fill: #fcd535; -fx-font-size: 16; -fx-font-weight: bold;" text="0.00 USDT" /></VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button onAction="#onBuy" prefHeight="50" prefWidth="120" style="-fx-background-color: #0ecb81; -fx-text-fill: white; -fx-font-weight: bold;" text="BUY" />
                                        <Button onAction="#onSell" prefHeight="50" prefWidth="120" style="-fx-background-color: #f6465d; -fx-text-fill: white; -fx-font-weight: bold;" text="SELL" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox fx:id="paneHistory" spacing="15" style="-fx-background-color: #0b0e11; -fx-padding: 25;" visible="false">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="TRADE HISTORY" />
                                <TableView fx:id="tableHistory" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colHistSymbol" text="Asset" />
                                        <TableColumn fx:id="colHistType" text="Side" />
                                        <TableColumn fx:id="colHistQty" text="Quantity" />
                                        <TableColumn fx:id="colHistPrice" text="Executed Price" />
                                        <TableColumn fx:id="colHistStatus" text="Status" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <VBox fx:id="paneAIChat" spacing="15" style="-fx-background-color: #0b0e11; -fx-padding: 25;" visible="false">
                            <children>
                                <Label style="-fx-text-fill: #fcd535; -fx-font-size: 22; -fx-font-weight: bold;" text="🤖 AI TRADING ANALYST" />
                                <TextArea fx:id="chatArea" editable="false" style="-fx-control-inner-background: #161a1e; -fx-text-fill: white; -fx-font-family: 'Consolas';" wrapText="true" VBox.vgrow="ALWAYS" />
                                <HBox spacing="10">
                                    <children>
                                        <TextField fx:id="txtChatInput" onAction="#onSendMessage" promptText="Ask Gemini..." style="-fx-background-color: #2b3139; -fx-text-fill: white; -fx-padding: 10;" HBox.hgrow="ALWAYS" />
                                        <Button onAction="#onSendMessage" prefHeight="40" prefWidth="100" style="-fx-background-color: #fcd535; -fx-text-fill: #0b0e11; -fx-font-weight: bold;" text="SEND" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" prefHeight="30.0" spacing="15" style="-fx-background-color: #161a1e; -fx-padding: 0 15; -fx-border-color: #2b3139; -fx-border-width: 1 0 0 0;">
            <children>
                <Label style="-fx-text-fill: #0ecb81; -fx-font-size: 10; -fx-font-weight: bold;" text="● MARKET LIVE" />
                <Separator orientation="VERTICAL" prefHeight="15.0" style="-fx-opacity: 0.2;" />
                <HBox fx:id="tickerContainer" alignment="CENTER_LEFT" spacing="30" />
            </children>
        </HBox>
    </children>
</VBox>
