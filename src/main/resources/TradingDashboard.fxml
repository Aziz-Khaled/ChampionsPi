<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<HBox prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #131722;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.TradingDashboard">
    <children>
        <VBox prefWidth="320.0" spacing="20" style="-fx-background-color: #1e222d; -fx-padding: 25;">
            <children>
                <VBox spacing="8">
                    <Label style="-fx-text-fill: #b2b5be; -fx-font-size: 11;" text="TOTAL BALANCE" />
                    <Label fx:id="lblBalance" style="-fx-text-fill: #00ff88; -fx-font-size: 24; -fx-font-weight: bold;" text="0.00 USDT" />
                    <Label fx:id="lblBalanceTND" style="-fx-text-fill: #d1d4dc; -fx-font-size: 14;" text="≈ 0.000 TND" />
                </VBox>
                <Separator opacity="0.1" />
                <TableView fx:id="tableAssets" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colSymbol" prefWidth="100.0" text="Asset" />
                        <TableColumn fx:id="colPrice" prefWidth="160.0" text="Price (USD)" />
                    </columns>
                </TableView>
            </children>
        </VBox>

        <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-padding: 20;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <children>
                        <VBox>
                            <Label fx:id="lblSelected" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="SELECT AN ASSET" />
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Circle radius="4" fill="#089981" />
                                <Label style="-fx-text-fill: #089981; -fx-font-size: 12;" text="Live Market" />
                            </HBox>
                        </VBox>
                        <Pane HBox.hgrow="ALWAYS" />
                        <HBox spacing="15" style="-fx-background-color: #1e222d; -fx-padding: 10; -fx-background-radius: 5;">
                            <children>
                                <Label fx:id="lblRSI" style="-fx-text-fill: white;" text="RSI: --" />
                                <Label fx:id="lblSignal" style="-fx-text-fill: #ffa502;" text="WAITING..." />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <LineChart fx:id="priceChart" animated="false" createSymbols="false" VBox.vgrow="ALWAYS">
                    <xAxis><CategoryAxis side="BOTTOM" tickLabelFill="#d1d4dc" /></xAxis>
                    <yAxis><NumberAxis side="LEFT" tickLabelFill="#d1d4dc" forceZeroInRange="false" /></yAxis>
                </LineChart>

                <GridPane hgap="20" vgap="10" style="-fx-background-color: #1e222d; -fx-padding: 25; -fx-background-radius: 10;">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <children>
                        <Label style="-fx-text-fill: #b2b5be;" text="Quantity" />
                        <TextField fx:id="txtQty" prefHeight="45.0" style="-fx-background-color: #2a2e39; -fx-text-fill: white;" GridPane.rowIndex="1" />
                        <Label style="-fx-text-fill: #b2b5be;" text="Order Type" GridPane.columnIndex="1" />
                        <ComboBox fx:id="comboMode" maxWidth="Infinity" prefHeight="45.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <VBox alignment="CENTER_RIGHT" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <children>
                                <Label fx:id="lblSL" style="-fx-text-fill: #ff4757;" text="SL: --" />
                                <Label fx:id="lblTP" style="-fx-text-fill: #2ed573;" text="TP: --" />
                                <Label fx:id="lblTotal" style="-fx-text-fill: white;" text="Total: 0.00" />
                            </children>
                        </VBox>
                        <Button onAction="#onBuy" maxWidth="Infinity" prefHeight="50.0" style="-fx-background-color: #089981; -fx-text-fill: white;" text="BUY" GridPane.columnSpan="2" GridPane.rowIndex="2" />
                        <Button onAction="#onSell" maxWidth="Infinity" prefHeight="50.0" style="-fx-background-color: #f23645; -fx-text-fill: white;" text="SELL" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                    </children>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>
            </children>
        </VBox>
    </children>
</HBox>