<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #131722;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.TradingDashboard">
    <children>

        <VBox prefWidth="320.0" spacing="20.0" style="-fx-background-color: #1e222d; -fx-padding: 20; -fx-border-color: #2a2e39; -fx-border-width: 0 1 0 0;">
            <children>

                <VBox spacing="10.0" style="-fx-background-color: #2a2e39; -fx-padding: 15; -fx-background-radius: 10;">
                    <children>
                        <Label text="AVAILABLE BALANCE" style="-fx-text-fill: #b2b5be; -fx-font-size: 11; -fx-font-weight: bold;" />
                        <Label fx:id="lblBalance" text="0.00 USDT" style="-fx-text-fill: #00ff88; -fx-font-size: 24; -fx-font-weight: bold;" />
                        <Label fx:id="lblBalanceTND" text="≈ 0.000 TND" style="-fx-text-fill: #d1d4dc;" />

                        <Separator opacity="0.1" style="-fx-padding: 5 0;" />

                        <HBox spacing="15">
                            <children>
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="EQUITY" style="-fx-text-fill: #b2b5be; -fx-font-size: 10;" />
                                    <Label fx:id="lblEquity" text="0.00" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="LIVE PnL" style="-fx-text-fill: #b2b5be; -fx-font-size: 10;" />
                                    <Label fx:id="lblPnL" text="0.00%" style="-fx-text-fill: #00ff88; -fx-font-weight: bold;" />
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Label text="MARKET WATCH" style="-fx-text-fill: white; -fx-font-weight: bold;">
                    <font><Font size="14.0" /></font>
                </Label>

                <TableView fx:id="tableAssets" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #2a2e39; -fx-border-radius: 5;">
                    <columns>
                        <TableColumn fx:id="colSymbol" prefWidth="110.0" text="Symbol" />
                        <TableColumn fx:id="colPrice" prefWidth="150.0" text="Price (USDT)" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <VBox spacing="20.0" HBox.hgrow="ALWAYS" style="-fx-padding: 20;">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <children>
                        <Label fx:id="lblSelected" text="SELECT AN ASSET" style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" />
                        <Label style="-fx-background-color: #2962ff; -fx-text-fill: white; -fx-padding: 3 8; -fx-background-radius: 4; -fx-font-size: 10; -fx-font-weight: bold;" text="REAL-TIME" />
                    </children>
                </HBox>

                <AnchorPane VBox.vgrow="ALWAYS" style="-fx-background-color: #1e222d; -fx-background-radius: 10; -fx-border-color: #2a2e39;">
                    <children>
                        <LineChart fx:id="priceChart" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10" animated="false" createSymbols="false" horizontalGridLinesVisible="false" verticalGridLinesVisible="false">
                            <xAxis><CategoryAxis side="BOTTOM" tickLabelFill="#d1d4dc" /></xAxis>
                            <yAxis><NumberAxis side="LEFT" tickLabelFill="#d1d4dc" forceZeroInRange="false" /></yAxis>
                        </LineChart>
                    </children>
                </AnchorPane>

                <VBox spacing="15.0" style="-fx-background-color: #1e222d; -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #2a2e39;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="30.0">
                            <children>
                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="Order Size" style="-fx-text-fill: #b2b5be; -fx-font-size: 12;" />
                                        <TextField fx:id="txtQty" prefHeight="45.0" prefWidth="200.0" promptText="Enter quantity..."
                                                   style="-fx-background-color: #2a2e39; -fx-text-fill: white; -fx-border-color: #434651; -fx-border-radius: 4; -fx-font-size: 14;" />
                                    </children>
                                </VBox>

                                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="lblTotal" text="Estimated Total: 0.00 USDT" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" />
                                        <Label text="Transaction fee: 0.1%" style="-fx-text-fill: #787b86; -fx-font-size: 11;" />
                                    </children>
                                </VBox>

                                <HBox spacing="15.0">
                                    <children>
                                        <Button onAction="#onBuyAction" prefHeight="55.0" prefWidth="160.0" text="BUY / LONG"
                                                style="-fx-background-color: #089981; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-cursor: hand; -fx-background-radius: 6;" />
                                        <Button onAction="#onSellAction" prefHeight="55.0" prefWidth="160.0" text="SELL / SHORT"
                                                style="-fx-background-color: #f23645; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-cursor: hand; -fx-background-radius: 6;" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>