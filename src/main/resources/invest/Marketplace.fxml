<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<HBox fx:id="mainContainer" prefHeight="850.0" prefWidth="1300.0" style="-fx-background-color: #F4F7FB;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.invest.MarketplaceController">

    <VBox prefWidth="260.0" style="-fx-background-color: #1e272e; -fx-padding: 30 20;">
        <children>
            <Label text="CHAMPIONS PI" textFill="WHITE" style="-fx-font-weight: 900; -fx-font-size: 22px;">
                <VBox.margin><Insets bottom="40.0" /></VBox.margin>
            </Label>

            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                <children>
                    <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-background-radius: 10;" text="🏠 Marketplace" />
                    <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-alignment: CENTER_LEFT;" text="📊 Mon Portefeuille" />
                    <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-alignment: CENTER_LEFT;" text="📑 Historique" />
                </children>
            </VBox>

            <Separator opacity="0.1" />
            <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-alignment: CENTER_LEFT;" text="🚪 Déconnexion" />
        </children>
    </VBox>

    <VBox HBox.hgrow="ALWAYS">
        <children>

            <HBox alignment="CENTER_LEFT" prefHeight="100.0" style="-fx-background-color: white; -fx-padding: 0 40;">
                <children>
                    <VBox alignment="CENTER_LEFT">
                        <children>
                            <Label text="Marketplace" textFill="#1e272e" style="-fx-font-weight: 800; -fx-font-size: 30px;" />
                            <Label text="Découvrez les meilleures opportunités" textFill="#7f8c8d" />
                        </children>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER" spacing="15.0">
                        <children>
                            <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: #F1F2F6; -fx-background-radius: 20; -fx-padding: 0 15;">
                                <children>
                                    <Label text="🔍" textFill="#95a5a6" />
                                    <TextField fx:id="txtSearch" promptText="Rechercher un projet..." style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
                                </children>
                            </HBox>
                            <Button fx:id="btnRefresh" style="-fx-background-color: #F1F2F6; -fx-background-radius: 50;" text="🔄" />
                        </children>
                    </HBox>
                </children>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="30.0" style="-fx-padding: 30 40;">
                        <children>

                            <HBox spacing="25.0">
                                <children>
                                    <VBox prefWidth="280.0" style="-fx-background-color: #093468; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                        <children>
                                            <HBox alignment="CENTER_LEFT" spacing="10">
                                                <Label text="📁" style="-fx-font-size: 18px;" />
                                                <Label text="Projets Disponibles" textFill="#7f8c8d" style="-fx-font-weight: bold;" />
                                            </HBox>
                                            <Label fx:id="lblTotalProjects" text="--" style="-fx-font-size: 28px; -fx-font-weight: 900;" textFill="#27ae60">
                                                <VBox.margin><Insets top="10.0" /></VBox.margin>
                                            </Label>
                                        </children>
                                    </VBox>

                                    <VBox prefWidth="280.0" style="-fx-background-color: #093468; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                        <children>
                                            <HBox alignment="CENTER_LEFT" spacing="10">
                                                <Label text="💰" style="-fx-font-size: 18px;" />
                                                <Label text="Volume Total" textFill="#7f8c8d" style="-fx-font-weight: bold;" />
                                            </HBox>
                                            <Label fx:id="lblTotalVolume" text="--" style="-fx-font-size: 28px; -fx-font-weight: 900;" textFill="#2980b9">
                                                <VBox.margin><Insets top="10.0" /></VBox.margin>
                                            </Label>
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>

                            <VBox spacing="15.0">
                                <children>
                                    <Label text="Filtrer par secteur" style="-fx-font-weight: bold; -fx-font-size: 16px;" textFill="#2d3436" />
                                    <HBox spacing="12.0">
                                        <children>
                                            <ComboBox fx:id="comboFilter" prefHeight="35.0" prefWidth="180.0" style="-fx-background-radius: 20; -fx-background-color: white; -fx-border-color: #dcdde1; -fx-border-radius: 20;" />
                                            <Label style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-padding: 6 15; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="Agriculture 🌱" />
                                            <Label style="-fx-background-color: #E3F2FD; -fx-text-fill: #1565C0; -fx-padding: 6 15; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="Technologie 💻" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <FlowPane fx:id="gridPane" hgap="25.0" vgap="25.0" prefWrapLength="1000.0" />

                        </children>
                    </VBox>
                </content>
            </ScrollPane>
        </children>
    </VBox>
</HBox>