<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<HBox fx:id="mainContainer" prefHeight="850.0" prefWidth="1300.0"
      style="-fx-background-color: #0f172a;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Champions.gui.invest.MarketplaceController">

    <VBox prefWidth="260.0" style="-fx-background-color: #020617; -fx-padding: 35 20;">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Circle fill="#38bdf8" radius="6.0" />
                <Label text="CHAMPIONS" textFill="WHITE" style="-fx-font-weight: 900; -fx-font-size: 22px; -fx-letter-spacing: 2;" />
                <VBox.margin><Insets bottom="50.0" /></VBox.margin>
            </HBox>

            <VBox spacing="15.0" VBox.vgrow="ALWAYS">
                <children>
                    <Button mnemonicParsing="false" prefHeight="50.0" prefWidth="220.0"
                            style="-fx-background-color: rgba(56, 189, 248, 0.1); -fx-text-fill: #38bdf8; -fx-alignment: CENTER_LEFT; -fx-background-radius: 12; -fx-padding: 0 20; -fx-font-weight: bold;"
                            text="🏠  Marketplace" />
                    <Button mnemonicParsing="false" prefHeight="50.0" prefWidth="220.0"
                            style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-alignment: CENTER_LEFT; -fx-padding: 0 20;"
                            text="📊  Mon Portefeuille" />
                    <Button mnemonicParsing="false" prefHeight="50.0" prefWidth="220.0"
                            style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-alignment: CENTER_LEFT; -fx-padding: 0 20;"
                            text="📑  Historique" />
                </children>
            </VBox>

            <Separator opacity="0.05" />
            <Button mnemonicParsing="false" prefHeight="50.0" prefWidth="220.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #f87171; -fx-alignment: CENTER_LEFT; -fx-padding: 0 20;"
                    text="🚪  Déconnexion" />
        </children>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">
        <children>

            <HBox alignment="CENTER_LEFT" prefHeight="120.0" style="-fx-padding: 0 40;">
                <children>
                    <VBox alignment="CENTER_LEFT">
                        <children>
                            <Label text="Marketplace" textFill="WHITE" style="-fx-font-weight: 900; -fx-font-size: 34px;" />
                            <Label text="Opportunités d'investissement IA" textFill="#94a3b8" style="-fx-font-size: 14px;" />
                        </children>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER" spacing="20.0">
                        <children>
                            <HBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="350.0"
                                  style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 0 20; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                                <children>
                                    <Label text="🔍" textFill="#64748b" style="-fx-font-size: 16px;" />
                                    <TextField fx:id="txtSearch" promptText="Rechercher un projet..."
                                               style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: #64748b;" HBox.hgrow="ALWAYS" />
                                </children>
                            </HBox>
                            <Button fx:id="btnRefresh" prefHeight="45.0" prefWidth="45.0"
                                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 12; -fx-text-fill: white;" text="🔄" />
                        </children>
                    </HBox>
                </children>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="35.0" style="-fx-padding: 0 40 40 40;">
                        <children>

                            <HBox spacing="30.0">
                                <children>
                                    <VBox prefWidth="320.0" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 25; -fx-border-color: rgba(255,255,255,0.05); -fx-border-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 15, 0, 0, 5);">
                                        <children>
                                            <Label text="📁 Projets Disponibles" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                            <Label fx:id="lblTotalProjects" text="24" textFill="WHITE" style="-fx-font-size: 32px; -fx-font-weight: 900;">
                                                <VBox.margin><Insets top="8.0" /></VBox.margin>
                                            </Label>
                                        </children>
                                    </VBox>

                                    <VBox prefWidth="320.0" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-padding: 25; -fx-border-color: rgba(255,255,255,0.05); -fx-border-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 15, 0, 0, 5);">
                                        <children>
                                            <Label text="💰 Volume Total" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                            <Label fx:id="lblTotalVolume" text="1.2M DT" textFill="#10b981" style="-fx-font-size: 32px; -fx-font-weight: 900;">
                                                <VBox.margin><Insets top="8.0" /></VBox.margin>
                                            </Label>
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>

                            <VBox spacing="15.0">
                                <children>
                                    <Label text="Filtrer par secteur" style="-fx-font-weight: bold; -fx-font-size: 14px;" textFill="#94a3b8" />
                                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                                        <children>
                                            <ComboBox fx:id="comboFilter" prefHeight="40.0" prefWidth="200.0"
                                                      style="-fx-background-radius: 12; -fx-background-color: #1e293b; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 12; -fx-text-fill: white;" />
                                            <Label style="-fx-background-color: rgba(16, 185, 129, 0.1); -fx-text-fill: #10b981; -fx-padding: 8 20; -fx-background-radius: 20; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-color: rgba(16,185,129,0.2); -fx-border-radius: 20;" text="Agriculture 🌱" />
                                            <Label style="-fx-background-color: rgba(56, 189, 248, 0.1); -fx-text-fill: #38bdf8; -fx-padding: 8 20; -fx-background-radius: 20; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-color: rgba(56,189,248,0.2); -fx-border-radius: 20;" text="Technologie 💻" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <FlowPane fx:id="gridPane" hgap="30.0" vgap="30.0" prefWrapLength="1100.0">
                                <VBox.margin><Insets bottom="40.0" /></VBox.margin>
                            </FlowPane>

                        </children>
                    </VBox>
                </content>
            </ScrollPane>
        </children>
    </VBox>
</HBox>