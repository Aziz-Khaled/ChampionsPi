<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="1100.0" spacing="0.0" style="-fx-background-color: #f5f6fa;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.invest.MarketplaceController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #f1f2f6; -fx-border-width: 0 0 2 0;">
            <children>
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Marketplace des Crédits" textFill="#2d3436">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label text="Consultez les demandes de financement actives" textFill="#b2bec3">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <TextField promptText="Rechercher un projet..." style="-fx-background-radius: 10; -fx-background-color: #f1f2f6; -fx-pref-width: 250; -fx-pref-height: 40;" />
                        <ComboBox fx:id="comboFilter" prefHeight="40.0" prefWidth="180.0" promptText="Tous les secteurs" style="-fx-background-color: white; -fx-border-color: #dcdde1; -fx-border-radius: 10; -fx-background-radius: 10;" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets left="40.0" right="40.0" />
            </padding>
        </HBox>

        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="gridPane" alignment="TOP_LEFT" hgap="35.0" vgap="35.0" style="-fx-background-color: #f5f6fa;">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </children>
</VBox>