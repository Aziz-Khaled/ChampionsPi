<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>

<VBox prefHeight="750.0" prefWidth="1200.0" spacing="0.0" style="-fx-background-color: #F8F9FD;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.invest.MarketplaceController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="110.0" spacing="25.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <children>
                <VBox alignment="CENTER_LEFT" spacing="5.0">
                    <children>
                        <Label text="Opportunités d'Investissement" textFill="#1e272e">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Circle fill="#27ae60" radius="5.0" />
                                <Label text="12 nouveaux projets cette semaine" textFill="#7f8c8d">
                                    <font>
                                        <Font name="System Italic" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="320.0" style="-fx-background-color: #F1F2F6; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12;">
                            <children>
                                <Label text=" 🔍 " textFill="#95a5a6" />
                                <TextField fx:id="txtSearch" promptText="Rechercher par titre, secteur..." style="-fx-background-color: transparent; -fx-prompt-text-fill: #95a5a6;" HBox.hgrow="ALWAYS">
                                    <font><Font size="14.0" /></font>
                                </TextField>
                            </children>
                            <padding><Insets left="10.0" right="10.0" /></padding>
                        </HBox>

                        <ComboBox fx:id="comboFilter" prefHeight="45.0" prefWidth="200.0" promptText="Tous les secteurs" style="-fx-background-color: white; -fx-border-color: #27ae60; -fx-border-radius: 12; -fx-background-radius: 12; -fx-font-weight: bold;" />

                        <Button fx:id="btnRefresh" prefHeight="45.0" prefWidth="45.0" style="-fx-background-color: #F1F2F6; -fx-background-radius: 12; -fx-cursor: hand;" text="🔄" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets left="50.0" right="50.0" />
            </padding>
        </HBox>

        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="20.0" style="-fx-background-color: #F8F9FD;">
                    <children>
                        <HBox spacing="20.0">
                            <children>
                                <Label style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-padding: 8 15; -fx-background-radius: 20;" text="Agriculture 🌱" />
                                <Label style="-fx-background-color: #E3F2FD; -fx-text-fill: #1565C0; -fx-padding: 8 15; -fx-background-radius: 20;" text="Technologie 💻" />
                                <Label style="-fx-background-color: #FFF3E0; -fx-text-fill: #E65100; -fx-padding: 8 15; -fx-background-radius: 20;" text="Énergie ⚡" />
                            </children>
                            <VBox.margin><Insets left="50.0" top="20.0" /></VBox.margin>
                        </HBox>

                        <FlowPane fx:id="gridPane" hgap="30.0" vgap="30.0">
                            <padding>
                                <Insets bottom="50.0" left="50.0" right="50.0" top="10.0" />
                            </padding>
                        </FlowPane>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>