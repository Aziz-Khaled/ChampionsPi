<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox fx:id="confirmRoot" alignment="CENTER" prefWidth="450.0" spacing="20.0"
      style="-fx-background-color: #1a1a1a; -fx-border-color: #333333; -fx-border-width: 2; -fx-background-radius: 15; -fx-border-radius: 15;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Champions.gui.invest.ConfirmTransactionController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <children>
        <VBox alignment="CENTER" spacing="5.0">
            <Label text="CONFIRMATION D'INVESTISSEMENT" textFill="#00d4ff">
                <font><Font name="System Bold" size="18.0" /></font>
            </Label>
            <Label text="Sécurité Blockchain Activée" textFill="#888888">
                <font><Font size="11.0" /></font>
            </Label>
        </VBox>

        <Separator opacity="0.1" />

        <VBox spacing="15.0" style="-fx-background-color: #252525; -fx-background-radius: 10; -fx-padding: 20;">
            <children>

                <VBox fx:id="containerRIB" spacing="8.0">
                    <children>
                        <Label text="VOTRE COMPTE DE PRÉLÈVEMENT :" textFill="#aaaaaa">
                            <font><Font name="System Bold" size="10.0" /></font>
                        </Label>
                        <ComboBox fx:id="comboWalletSelection" prefHeight="35.0" prefWidth="380.0"
                                  promptText="Choisir un RIB..."
                                  style="-fx-background-color: #333333; -fx-text-fill: white; -fx-border-color: #444444;" />
                        <Separator opacity="0.05" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT">
                    <Label prefWidth="120.0" text="DESTINATAIRE :" textFill="#aaaaaa" />
                    <Label fx:id="lblDestinataire" text="Chargement..." textFill="WHITE" />
                </HBox>

                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="MONTANT TOTAL" textFill="#aaaaaa">
                        <font><Font size="10.0" /></font>
                    </Label>
                    <Label fx:id="lblMontant" text="0.00 TND" textFill="#00ff88">
                        <font><Font name="System Bold" size="28.0" /></font>
                    </Label>
                </VBox>

                <Separator opacity="0.05" />

                <VBox spacing="10.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label prefWidth="150.0" text="SOLDE ACTUEL :" textFill="#aaaaaa" />
                        <Label fx:id="lblSoldeActuel" text="---" textFill="WHITE" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT">
                        <Label prefWidth="150.0" text="SOLDE APRÈS TRANSFERT :" textFill="#aaaaaa" />
                        <Label fx:id="lblNouveauSolde" text="---" textFill="#00d4ff">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                    </HBox>
                </VBox>
            </children>
        </VBox>

        <HBox alignment="CENTER" spacing="20.0">
            <Button onAction="#handleAnnuler" prefHeight="40.0" prefWidth="120.0"
                    style="-fx-background-color: transparent; -fx-border-color: #555555; -fx-text-fill: white; -fx-cursor: hand;" text="ANNULER" />
            <Button fx:id="btnConfirmer" onAction="#handleConfirmation" prefHeight="40.0" prefWidth="200.0"
                    style="-fx-background-color: linear-gradient(to right, #00d4ff, #00ff88); -fx-text-fill: #1a1a1a; -fx-font-weight: bold; -fx-cursor: hand;" text="CONFIRMER" />
        </HBox>
    </children>
</VBox>