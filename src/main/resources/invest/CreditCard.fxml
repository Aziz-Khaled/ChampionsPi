<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="450.0" maxWidth="350.0" minHeight="450.0" minWidth="330.0" prefHeight="450.0" prefWidth="350.0" style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #dcdde1; -fx-border-radius: 18; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.invest.CreditCardController">
    <children>
        <AnchorPane maxHeight="160.0" minHeight="160.0" prefHeight="160.0">
            <children>
                <ImageView fx:id="imgProject" fitHeight="160.0" fitWidth="348.0" pickOnBounds="true" preserveRatio="false" />
            </children>
        </AnchorPane>

        <VBox spacing="15.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label fx:id="lblTitle" minHeight="60.0" prefHeight="60.0" text="Titre du Projet" wrapText="true" style="-fx-text-fill: #2f3640; -fx-font-weight: bold; -fx-font-size: 18px;" />

                <Separator />

                <HBox spacing="20.0">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="MONTANT" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px; -fx-font-weight: bold;" />
                            <Label fx:id="lblMontant" text="0.00 DT" style="-fx-text-fill: #2f3640; -fx-font-size: 16px; -fx-font-weight: bold;" />
                        </VBox>
                        <VBox alignment="TOP_RIGHT" HBox.hgrow="ALWAYS">
                            <Label text="TAUX" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px; -fx-font-weight: bold;" />
                            <Label fx:id="lblTaux" text="0%" style="-fx-text-fill: #44bd32; -fx-font-size: 16px; -fx-font-weight: bold;" />
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" minHeight="70.0" prefHeight="70.0" style="-fx-background-color: #f5f6fa; -fx-background-radius: 0 0 18 18;">
            <padding><Insets left="20.0" right="20.0" /></padding>
            <children>
                <Label fx:id="lblRisque" text="STATUS" style="-fx-background-color: #dff9fb; -fx-text-fill: #0984e3; -fx-padding: 5 10; -fx-background-radius: 5; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleInvest" text="Détails" style="-fx-background-color: #0984e3; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-padding: 8 20;" />
            </children>
        </HBox>
    </children>
</VBox>