<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<VBox fx:id="cardRoot" maxHeight="480.0" maxWidth="350.0" minHeight="450.0" minWidth="330.0"
      prefHeight="460.0" prefWidth="350.0"
      style="-fx-background-color: linear-gradient(to bottom right, #1e293b, #0f172a); -fx-background-radius: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 20, 0, 0, 15);"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Champions.gui.invest.CreditCardController">

    <children>
        <AnchorPane maxHeight="200.0" minHeight="200.0" prefHeight="200.0">
            <children>
                <ImageView fx:id="imgProject" fitHeight="200.0" fitWidth="350.0" pickOnBounds="true" preserveRatio="false">
                    <clip>
                        <Rectangle arcHeight="50" arcWidth="50" height="200.0" width="350.0" />
                    </clip>
                </ImageView>
                <Region prefHeight="200.0" prefWidth="350.0" style="-fx-background-color: linear-gradient(to bottom, transparent, rgba(15,23,42,0.8));" />

                <Label layoutX="15.0" layoutY="15.0"
                       style="-fx-background-color: rgba(255,255,255,0.15); -fx-backdrop-filter: blur(10); -fx-text-fill: white; -fx-padding: 6 15; -fx-background-radius: 20; -fx-font-size: 11; -fx-font-weight: bold; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 20;"
                       text="⌛ 12 MOIS" />
            </children>
        </AnchorPane>

        <VBox spacing="15.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
            </padding>
            <children>
                <Label fx:id="lblTitle" minHeight="50.0" prefHeight="55.0" text="Modernisation Ferme Solaire" wrapText="true"
                       style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 22px; -fx-line-spacing: 1;" />

                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Financement actuel" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblProgressionText" text="65%" style="-fx-text-fill: #38bdf8; -fx-font-size: 12; -fx-font-weight: bold;" />
                    </HBox>
                    <ProgressBar fx:id="progressFinancement" prefWidth="300.0" progress="0.65"
                                 style="-fx-accent: #38bdf8; -fx-background-insets: 0; -fx-padding: 0; -fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 10;" />
                </VBox>

                <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: rgba(255,255,255,0.03); -fx-padding: 10; -fx-background-radius: 15;">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="CIBLE" style="-fx-text-fill: #64748b; -fx-font-size: 10px; -fx-font-weight: bold;" />
                            <Label fx:id="lblMontant" text="45,000 DT" style="-fx-text-fill: #ffffff; -fx-font-size: 17px; -fx-font-weight: bold;" />
                        </VBox>
                        <Separator orientation="VERTICAL" style="-fx-opacity: 0.1;" />
                        <VBox alignment="TOP_RIGHT" HBox.hgrow="ALWAYS">
                            <Label text="RENDEMENT" style="-fx-text-fill: #64748b; -fx-font-size: 10px; -fx-font-weight: bold;" />
                            <Label fx:id="lblTaux" text="8.5%" style="-fx-text-fill: #10b981; -fx-font-size: 17px; -fx-font-weight: bold;" />
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" minHeight="85.0" prefHeight="85.0" style="-fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 0 0 25 25;">
            <padding><Insets left="25.0" right="25.0" /></padding>
            <children>
                <Label fx:id="lblRisque" text="RISQUE MODÉRÉ"
                       style="-fx-background-color: rgba(245, 158, 11, 0.1); -fx-text-fill: #fbbf24; -fx-padding: 8 15; -fx-background-radius: 20; -fx-font-size: 10; -fx-font-weight: bold; -fx-border-color: rgba(245, 158, 11, 0.3); -fx-border-radius: 20;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleInvest" text="Investir"
                        style="-fx-background-color: #ffffff; -fx-text-fill: #0f172a; -fx-background-radius: 15; -fx-font-weight: bold; -fx-font-size: 14; -fx-padding: 12 30; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(255,255,255,0.1), 10, 0, 0, 0);" />
            </children>
        </HBox>
    </children>
</VBox>