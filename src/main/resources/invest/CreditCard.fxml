<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<VBox fx:id="cardRoot" maxHeight="460.0" maxWidth="350.0" minHeight="450.0" minWidth="330.0"
      prefHeight="450.0" prefWidth="350.0"
      style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Champions.gui.invest.CreditCardController">

    <children>
        <AnchorPane maxHeight="180.0" minHeight="180.0" prefHeight="180.0">
            <children>
                <ImageView fx:id="imgProject" fitHeight="180.0" fitWidth="350.0" pickOnBounds="true" preserveRatio="false">
                </ImageView>
                <Label layoutX="15.0" layoutY="15.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-text-fill: #2d3436; -fx-padding: 5 12; -fx-background-radius: 15; -fx-font-size: 11; -fx-font-weight: bold;" text="12 Mois" />
            </children>
        </AnchorPane>

        <VBox spacing="12.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
                <Label fx:id="lblTitle" minHeight="50.0" prefHeight="55.0" text="Modernisation Ferme Solaire" wrapText="true"
                       style="-fx-text-fill: #1e272e; -fx-font-weight: bold; -fx-font-size: 20px; -fx-line-spacing: 1;" />

                <VBox spacing="5">
                    <Label text="Progression du financement" style="-fx-text-fill: #b2bec3; -fx-font-size: 11;" />
                    <ProgressBar fx:id="progressFinancement" prefWidth="300.0" progress="0.65"
                                 style="-fx-accent: #27ae60; -fx-background-insets: 0; -fx-padding: 0;" />
                </VBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="MONTANT CIBLE" style="-fx-text-fill: #b2bec3; -fx-font-size: 10px; -fx-font-weight: bold;" />
                            <Label fx:id="lblMontant" text="45,000 DT" style="-fx-text-fill: #27ae60; -fx-font-size: 18px; -fx-font-weight: 800;" />
                        </VBox>
                        <Separator orientation="VERTICAL" />
                        <VBox alignment="TOP_RIGHT" HBox.hgrow="ALWAYS">
                            <Label text="RENDEMENT" style="-fx-text-fill: #b2bec3; -fx-font-size: 10px; -fx-font-weight: bold;" />
                            <Label fx:id="lblTaux" text="8.5%" style="-fx-text-fill: #2d3436; -fx-font-size: 18px; -fx-font-weight: 800;" />
                        </VBox>
                    </children>
                    <VBox.margin><Insets top="5.0" /></VBox.margin>
                </HBox>
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" minHeight="80.0" prefHeight="80.0" style="-fx-background-color: #fcfcfc; -fx-background-radius: 0 0 20 20; -fx-border-color: #f1f2f6; -fx-border-width: 1 0 0 0;">
            <padding><Insets left="25.0" right="25.0" /></padding>
            <children>
                <Label fx:id="lblRisque" text="NIVEAU : MODÉRÉ"
                       style="-fx-background-color: #FFF3E0; -fx-text-fill: #E65100; -fx-padding: 6 12; -fx-background-radius: 20; -fx-font-size: 11; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleInvest" text="Investir"
                        style="-fx-background-color: #2d3436; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-weight: bold; -fx-font-size: 13; -fx-padding: 10 25; -fx-cursor: hand;" />
            </children>
        </HBox>
    </children>
</VBox>