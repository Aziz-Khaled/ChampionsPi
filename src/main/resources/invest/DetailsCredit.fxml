<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.chart.PieChart?>

<VBox fx:id="detailsRoot" prefHeight="850.0" prefWidth="1150.0" style="-fx-background-color: #F4F7FB;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.invest.DetailsCreditController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" style="-fx-background-color: #1e272e; -fx-padding: 0 40;">
            <children>
                <Button onAction="#retourMarketplace" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;" text="← Marketplace" />
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="lblTitle" style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: white;" text="Chargement du projet..." />
                    <HBox spacing="10">
                        <Label fx:id="lblSecteurBadge" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" text="SECTEUR" />
                        <Label text="•" textFill="WHITE" />
                        <Label fx:id="lblWalletSolde" style="-fx-text-fill: #bdc3c7;" text="Solde Wallet: 0.00 TND" />
                    </HBox>
                </VBox>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <content>
                <HBox spacing="30.0" style="-fx-padding: 30;">
                    <children>
                        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                            <children>
                                <ImageView fx:id="imgLarge" fitHeight="380.0" fitWidth="720.0" pickOnBounds="true" preserveRatio="false">
                                    <clip><Rectangle arcHeight="25.0" arcWidth="25.0" height="380.0" width="720.0" /></clip>
                                </ImageView>

                                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                    <Label text="📑 DESCRIPTION DU PROJET" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                    <Label fx:id="lblDescription" style="-fx-font-size: 14px; -fx-text-fill: #636e72; -fx-line-spacing: 4;" text="Description indisponible." wrapText="true" />

                                    <Separator />

                                    <Label text="🛡️ ÉTUDE DE RISQUE IA" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                    <VBox fx:id="reportContainer" spacing="12">
                                        <Label text="Analyse en attente..." textFill="#95a5a6" />
                                    </VBox>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox maxWidth="380.0" minWidth="380.0" spacing="20.0">
                            <children>
                                <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                    <Label text="SCORE DE FIABILITÉ" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 11px;" />
                                    <PieChart fx:id="riskChart" maxHeight="180.0" legendVisible="false" />
                                    <Label fx:id="lblScoreRisque" style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #2c3e50;" text="--%" />
                                    <Button onAction="#genererEtudePro" maxWidth="Infinity" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 8;" text="Actualiser l'Analyse 🤖" />
                                </VBox>

                                <VBox spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                    <Label text="Simulateur d'Investissement" style="-fx-font-weight: bold; -fx-font-size: 15px;" />
                                    <Slider fx:id="investmentSlider" style="-fx-cursor: hand;" />

                                    <VBox spacing="8">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="Montant :" textFill="#7f8c8d" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="lblSimulatedAmount" style="-fx-font-weight: 900; -fx-font-size: 16px;" text="0 TND" />
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="Gain estimé :" textFill="#7f8c8d" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="lblEstimatedProfit" style="-fx-text-fill: #27ae60; -fx-font-weight: 900; -fx-font-size: 16px;" text="+0 TND" />
                                        </HBox>
                                    </VBox>

                                    <Button fx:id="btnInvestir" maxWidth="Infinity" style="-fx-background-color: #1e272e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15; -fx-background-radius: 10; -fx-cursor: hand;" text="Confirmer l'Investissement 💸" />
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </content>
        </ScrollPane>
    </children>
</VBox>