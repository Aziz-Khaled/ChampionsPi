<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.Cursor?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.admin_wallet_controller">
    <BorderPane prefHeight="700.0" prefWidth="1400.0">
        <left>
            <VBox prefHeight="700.0" prefWidth="220.0" spacing="0.0" style="-fx-background-color: #2c3e50;">
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 25 15 20 15; -fx-background-color: #34495e;">
                    <Circle fill="#ecf0f1" radius="40.0" stroke="#1abc9c" strokeWidth="3.0" />
                    <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="Admin User" textFill="WHITE" />
                    <Label style="-fx-font-size: 11;" text="Back Office" textFill="#95a5a6" />
                    <Separator prefWidth="200.0" />
                </VBox>
                <VBox spacing="0.0" VBox.vgrow="ALWAYS">
                    <Button maxWidth="Infinity" style="-fx-text-fill: white; -fx-background-color: #2c3e50; -fx-padding: 12 20;" text="📊 Dashboard" />
                    <Button maxWidth="Infinity" style="-fx-text-fill: #1abc9c; -fx-background-color: #34495e; -fx-padding: 12 20; -fx-border-color: #1abc9c; -fx-border-width: 0 0 0 3;" text="💰 Currency" />
                </VBox>
                <VBox alignment="BOTTOM_CENTER" style="-fx-padding: 15;">
                    <Button fx:id="btnSignOut" maxWidth="Infinity" style="-fx-text-fill: #e74c3c; -fx-background-color: transparent;" text="🚪 Sign Out" />
                </VBox>
            </VBox>
        </left>

        <center>
            <VBox spacing="0.0" style="-fx-background-color: #ecf0f1;">
                <HBox alignment="CENTER_LEFT" prefHeight="61.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 0 20; -fx-border-color: #bdc3c7; -fx-border-width: 0 0 1 0;">
                    <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Currency Management" />
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- NOTIFICATION ICON -->
                    <AnchorPane onMouseClicked="#toggleNotifications" style="-fx-cursor: hand;">

                        <!-- Bell -->
                        <Label text="🔔" style="-fx-font-size: 24;" />

                        <!-- Badge (fond rouge) -->
                        <Circle fx:id="notifBadge"
                                fill="#e74c3c"
                                radius="9"
                                layoutX="22"
                                layoutY="8"
                                visible="false"
                                stroke="WHITE"
                                strokeWidth="1.5" />

                        <!-- Nombre notifications -->
                        <Label fx:id="notifCountLabel"
                               text="0"
                               textFill="WHITE"
                               layoutX="18"
                               layoutY="2"
                               style="-fx-font-size: 10; -fx-font-weight: bold;"
                               visible="false"/>

                    </AnchorPane>

                    <Label style="-fx-font-size: 12; -fx-text-fill: #7f8c8d;" text="Welcome, Admin!" />
                </HBox>

                <HBox spacing="15.0" style="-fx-padding: 15;" VBox.vgrow="ALWAYS">
                    <VBox prefWidth="350.0" spacing="15.0" style="-fx-padding: 20; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                        <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1a5f7a;" text="Currency Form" />
                        <GridPane vgap="15.0" hgap="10.0">
                            <Label text="Code" GridPane.rowIndex="0" />
                            <ComboBox fx:id="boxCode" prefWidth="200.0" GridPane.columnIndex="1" />
                            <Label text="Name" GridPane.rowIndex="1" />
                            <Label fx:id="lblName" text="---" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <Label text="Type" GridPane.rowIndex="2" />
                            <ComboBox fx:id="boxType" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <Label text="Is Trading" GridPane.rowIndex="3" />
                            <CheckBox fx:id="chkIsTrading" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        </GridPane>
                        <HBox spacing="10.0" alignment="CENTER">
                            <Button text="+" fx:id="add_currency" style="-fx-background-color: #ecf0f1; -fx-font-size: 20;" prefWidth="60" />
                            <Button text="✏" onAction="#handleModify" style="-fx-background-color: #ecf0f1; -fx-font-size: 20;" prefWidth="60" />
                            <Button text="🗑" onAction="#handleDelete" style="-fx-background-color: #ecf0f1; -fx-font-size: 20;" prefWidth="60" />
                        </HBox>
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" spacing="10.0">
                        <TableView fx:id="table" VBox.vgrow="ALWAYS" style="-fx-background-radius: 5;">
                            <columns>
                                <TableColumn fx:id="colCode" text="Code" prefWidth="100" />
                                <TableColumn fx:id="colName" text="Name" prefWidth="200" />
                                <TableColumn fx:id="colType" text="Type" prefWidth="100" />
                                <TableColumn fx:id="colIsTrading" text="Trading" prefWidth="100" />
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>
            </VBox>
        </center>
    </BorderPane>

    <AnchorPane fx:id="notifPane" visible="false" mouseTransparent="false">
        <VBox layoutX="1080.0" layoutY="60.0" prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 15, 0, 0, 5); -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
            <HBox style="-fx-padding: 10; -fx-background-color: #f8f9fa; -fx-background-radius: 5 5 0 0;">
                <Label text="Notifications Securité" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            </HBox>
            <ScrollPane fitToWidth="true" prefHeight="350.0" style="-fx-background-color: transparent; -fx-padding: 5;">
                <VBox fx:id="notifContainer" spacing="10.0" />
            </ScrollPane>
        </VBox>
    </AnchorPane>
</StackPane>