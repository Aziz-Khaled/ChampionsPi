<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>


<HBox prefHeight="800.0" prefWidth="1100.0" styleClass="main-container" stylesheets="@/Styles/Styless.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Champions.gui.AuthService">
    <children>
        <VBox alignment="CENTER_LEFT" prefWidth="420.0" spacing="35.0" styleClass="brand-section" HBox.hgrow="NEVER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <StackPane styleClass="logo-box" prefWidth="45" prefHeight="45">
                            <children>
                                <Label style="-fx-font-family: 'System'; -fx-font-style: italic; -fx-font-weight: 900; -fx-font-size: 22;" text="C" textFill="WHITE" />
                            </children>
                        </StackPane>
                        <Label styleClass="brand-title" text="CHAMPIONS." />
                    </children>
                </HBox>
                <VBox spacing="15.0">
                    <children>
                        <Label styleClass="brand-headline" text="Empowering the future of Fintech." wrapText="true" />
                        <Label styleClass="brand-subtext" text="Join thousands of users who trust Champions for their financial growth." wrapText="true" />
                    </children>
                </VBox>
                <Region VBox.vgrow="ALWAYS" />
                <Label styleClass="brand-subtext" text="© 2026 Champions Platform" />
            </children>
        </VBox>

        <VBox alignment="CENTER" styleClass="form-section" HBox.hgrow="ALWAYS">
            <children>
                <VBox maxWidth="550.0" spacing="35.0" styleClass="form-content-area">
                    <children>
                        <VBox spacing="10.0">
                            <children>
                                <Label styleClass="brand-title" style="-fx-font-size: 32;" text="Create Account" />
                                <Label fx:id="stepDescription" styleClass="brand-subtext" text="Step 1: Personal Details" />
                                <HBox spacing="10" style="-fx-padding: 15 0 0 0;">
                                    <Region fx:id="prog1" prefHeight="4" styleClass="prog-active" HBox.hgrow="ALWAYS" />
                                    <Region fx:id="prog2" prefHeight="4" styleClass="prog-inactive" HBox.hgrow="ALWAYS" />
                                </HBox>
                            </children>
                        </VBox>

                        <StackPane>
                            <children>
                                <VBox fx:id="step1Container" spacing="25">
                                    <children>
                                        <GridPane hgap="20.0" vgap="20.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                            </columnConstraints>
                                            <children>
                                                <VBox spacing="8.0">
                                                    <children><Label styleClass="input-label" text="Nom" /><TextField fx:id="TF_Nom" promptText="Doe" /></children>
                                                </VBox>
                                                <VBox spacing="8.0" GridPane.columnIndex="1">
                                                    <children><Label styleClass="input-label" text="Prénom" /><TextField fx:id="TF_Prenom" promptText="John" /></children>
                                                </VBox>
                                                <VBox spacing="8.0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                                    <children>
                                                        <Label styleClass="input-label" text="Email" />
                                                        <HBox spacing="10">
                                                            <children>
                                                                <TextField fx:id="TF_Email" promptText="john@example.com" HBox.hgrow="ALWAYS" />
                                                                <Button fx:id="btnSendOTP" onAction="#handleSendOTP" styleClass="button-secondary" text="Verify" />
                                                            </children>
                                                        </HBox>
                                                        <HBox fx:id="otpContainer" managed="false" spacing="10" visible="false" alignment="CENTER_LEFT">
                                                            <children>
                                                                <TextField fx:id="TF_OTP" prefWidth="120.0" promptText="6-digit code" />
                                                                <Button onAction="#handleVerifyOTP" styleClass="button-primary" text="Confirm Code" />
                                                                <Label fx:id="lblOtpStatus" style="-fx-font-size: 18;" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="8.0" GridPane.columnSpan="2" GridPane.rowIndex="2">
                                                    <children><Label styleClass="input-label" text="Téléphone" /><TextField fx:id="TF_Telephone" promptText="+216 ..." /></children>
                                                </VBox>
                                            </children>
                                        </GridPane>
                                        <VBox spacing="8.0">
                                            <children><Label styleClass="input-label" text="Password" /><PasswordField fx:id="TF_Password" promptText="••••••••" /></children>
                                        </VBox>

                                        <Button maxWidth="Infinity" onAction="#nextStep" styleClass="button-primary" text="Continue to Verification →" />
                                        <HBox alignment="CENTER" spacing="8">
                                            <Label styleClass="brand-subtext" text="Already have an account?" />
                                            <Button fx:id="Login_Button" onAction="#openLoginPage" styleClass="button-secondary" text="Sign In" />
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox fx:id="step2Container" managed="false" spacing="25" visible="false">
                                    <children>
                                        <VBox spacing="10.0">
                                            <children>
                                                <Label styleClass="input-label" text="How will you use this platform?" />
                                                <ComboBox fx:id="combobox_role" maxWidth="Infinity" promptText="Select your account type" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="12.0">
                                            <children>
                                                <Label styleClass="input-label" text="Identity Verification Documents" />
                                                <HBox spacing="15.0">
                                                    <children>
                                                        <VBox fx:id="box_Identity" alignment="CENTER" spacing="15.0" styleClass="file-upload-box" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label style="-fx-font-size: 30;" text="🪪" />
                                                                <VBox alignment="CENTER" spacing="2.0">
                                                                    <Label styleClass="input-label" style="-fx-font-size: 13;" text="National ID" />
                                                                    <Label styleClass="brand-subtext" style="-fx-font-size: 10;" text="PDF or Image" />
                                                                </VBox>
                                                                <Button fx:id="Identity_Button" styleClass="button-upload" text="Choose File" />
                                                            </children>
                                                        </VBox>

                                                        <VBox fx:id="box_Personal" alignment="CENTER" spacing="15.0" styleClass="file-upload-box" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label style="-fx-font-size: 30;" text="📸" />
                                                                <VBox alignment="CENTER" spacing="2.0">
                                                                    <Label styleClass="input-label" style="-fx-font-size: 13;" text="Selfie Photo" />
                                                                    <Label styleClass="brand-subtext" style="-fx-font-size: 10;" text="Clear Face" />
                                                                </VBox>
                                                                <Button fx:id="personalImage_button" onAction="#handleLiveSelfie" styleClass="button-upload" text="Take Live Photo" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <HBox spacing="15">
                                            <children>
                                                <Button onAction="#prevStep" prefWidth="120.0" styleClass="button-secondary" style="-fx-border-color: #333; -fx-border-radius: 12;" text="Back" />
                                                <Button fx:id="signUpButton" maxWidth="Infinity" styleClass="button-primary" text="Complete Registration" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>